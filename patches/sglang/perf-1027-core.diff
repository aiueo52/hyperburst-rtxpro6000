+@triton.jit
+def _draft_extend_select_finalize_kernel(
+    partial_vals,
+    partial_indices,
+    partial_sums,
+    topk_p,
+    topk_index,
+    conf_out,
+    num_splits: tl.constexpr,
+    WRITE_PROB: tl.constexpr,
+    BLOCK: tl.constexpr,
