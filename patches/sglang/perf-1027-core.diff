+    redact_next = False
+    for index, arg in enumerate(argv):
+        name, separator, _ = arg.partition("=")
+        normalized_name = name.lstrip("-").lower().replace("_", "-")
+        checked_name = bool(normalized_name) and normalized_name not in nonsensitive_prefixes
