+    BLOCK_SIZE = 1024
+    key = tuple(
+        (dst.data_ptr(), src.data_ptr(), dst.dtype)
+        + tuple(src.stride())
+        + tuple(src.shape)
+        + tuple(dst.stride())
+        + tuple(dst.shape)
+        for dst, src in list(conv_pairs) + list(flat_pairs)
