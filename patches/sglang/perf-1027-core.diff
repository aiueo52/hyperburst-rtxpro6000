+    if KERNEL_WIDTH >= 4:
+        idx_in3 = idx_t
+        x_ptrs3 = x_base[None, :] + (idx_in3 * stride_x_token)[:, None]
+        matrix_x3 = tl.load(
+            x_ptrs3,
+            (idx_in3 >= 0)[:, None] & (idx_in3 < seqlen)[:, None] & mask_w[None, :],
+            0.0,
+        )
