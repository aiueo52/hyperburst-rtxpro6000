+                or tuple(weight.shape) != (rows, hidden // 2)
+                or not isinstance(packed, torch.Tensor)
+                or packed.data_ptr() != weight.data_ptr()
+                or not isinstance(scales, torch.Tensor)
+                or tuple(scales.shape) != (rows, hidden // 16)
