+@triton.jit
+def _fused_commit_glue_scatter_kernel(
+    meta_ptr,  # int64 [num_types, 17], columns in _commit_glue_build_meta
+    idx1_ptr,
+    step1_ptr,
+    idx2_ptr,
+    step2_ptr,
