+@triton.jit
+def _qsa_decode_attn_kernel(
+    q_ptr,
+    k_ptr,
+    v_ptr,
+    out_ptr,
+    seq_lens_ptr,
+    topk_ptr,
+    req_to_token_ptr,
+    row_req_ptr,
+    partial_out_ptr,
+    partial_lse_ptr,
