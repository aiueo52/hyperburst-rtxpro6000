+    if idx_seq >= batch:
+        return
+
+    # [BLOCK_N,] elements along the feature-dimension (channel)
+    idx_feats = tl.program_id(1) * BLOCK_N + tl.arange(0, BLOCK_N)
+    # [BLOCK_T,] output tokens handled by this CTA
+    idx_tile = tl.program_id(2)
+    is_first_tile = idx_tile == 0
