+        and k_buffer.dtype == torch.float8_e4m3fn
+        and v_buffer.dtype == k_buffer.dtype
+        and v_buffer.shape == k_buffer.shape
+        and head_dim == _HEAD_DIM
+        and k_buffer.shape[2] == head_dim
