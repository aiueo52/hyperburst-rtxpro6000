+        grp,
+        sid,
+        qo_off,
+        offs_h,
+        offs_d,
+        hmask,
+        GROUP=GROUP,
+        BLOCK_H=BLOCK_H,
+        D=D,
+        NUM_SPLITS=NUM_SPLITS,
+    )
