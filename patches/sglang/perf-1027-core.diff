+def _causal_conv1d_update_chain_kernel(
+    # Pointers to matrices
+    x_ptr,  # (batch, dim, seqlen)
+    w_ptr,  # (dim, width)
+    bias_ptr,
+    conv_state_ptr,
+    conv_state_indices_ptr,
+    intermediate_conv_window_ptr,
+    intermediate_state_indices_ptr,
+    o_ptr,  # (batch, dim, seqlen)
