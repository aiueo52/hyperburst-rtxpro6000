+    elif KERNEL_WIDTH == 4:
+        matrix_x0 = tl.where((idx_in0 == -1)[:, None], col2[None, :], matrix_x0)
+        matrix_x0 = tl.where((idx_in0 == -2)[:, None], col1[None, :], matrix_x0)
+        matrix_x0 = tl.where((idx_in0 == -3)[:, None], col0[None, :], matrix_x0)
