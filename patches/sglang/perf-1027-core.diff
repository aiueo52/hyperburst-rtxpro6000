+        partial_vals,
+        partial_indices,
+        partial_sums,
+        topk_p,
+        topk_index,
+        conf if write_prob else topk_p,
+        num_splits,
+        WRITE_PROB=write_prob,
+        BLOCK=triton.next_power_of_2(num_splits),
+        num_warps=1,
+    )
