+    d1 = tl.load(idx1_ptr + off1, mask=is1, other=-1).to(tl.int64)
+    d2 = tl.load(idx2_ptr + off2, mask=is2, other=-1).to(tl.int64)
+    dst_idx = tl.where(is2, d2, d1)
+    src_idx = tl.where(is2, off2, off1).to(tl.int64)
+    if dst_idx < 0:
+        return
