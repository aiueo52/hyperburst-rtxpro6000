diff --git a/python/sglang/srt/layers/moe/oea_prologue.py b/python/sglang/srt/layers/moe/oea_prologue.py
new file mode 100644
index 000000000..a35334cb3
--- /dev/null
+++ b/python/sglang/srt/layers/moe/oea_prologue.py
@@ -0,0 +1,246 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 aiueo52 and contributors
+
+"""Per-call pointers for OEA in FlashInfer's P2 prologue.
+
+oea-sd (OEA on the 2-D tree): the device cell is int32[2] = {k0, min_rows}. FlashInfer's merged prologue
+(flashinfer-vtoea, fused_moe_120_vtoea_prologue_v1) applies OEA only when at least min_rows rows take part in the
+call: the VT live rows 0..L when VT passes vt_lens, every row otherwise. min_rows starts at SGLANG_OEA_MIN_ROWS
+(16: OEA only on full 16-row verifies, the regime the spare entry was measured in) and the control file may switch
+it at run time (2..WIDTH), together with mode and k0. The "rows" counter is the live rows.
+
+The control thread writes the cell's two words with one 8-byte store. It reads the control file only after
+mark_serving(), which run_scheduler_process (managers/scheduler.py) calls once Scheduler(...) has returned, i.e. after
+every CUDA graph of this process is captured: applying a switch synchronizes the device, which would break a capture.
+It says so in one "serving" line of the status file; `oea` writes nothing before that line.
+"""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+import json
+import logging
+import os
+import threading
+import time
+
+import torch
+
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+STAT_NAMES = (
+    "calls", "rows", "valid_routes", "kept_routes", "d_before", "d_after",
+    "mass_frac_sum", "oea_calls",
+)
+K0 = envs.SGLANG_OEA_K0.get() or 0
+MODE = envs.SGLANG_OEA_MODE.get()
+WIDTH = envs.SGLANG_OEA_WIDTH.get()
+MAX_BS = envs.SGLANG_OEA_MAX_BS.get()
+MIN_ROWS = envs.SGLANG_OEA_MIN_ROWS.get()
+STATS = envs.SGLANG_OEA_STATS.get()
+CTL_FILE = envs.SGLANG_OEA_CTL_FILE.get()
+if not 0 <= K0 <= 9 or MODE not in {"oea", "prod"}:
+    raise ValueError("OEA requires k0 in [0, 9] and mode in {oea, prod}")
+if WIDTH < 1 or MAX_BS < 1 or not 2 <= MIN_ROWS <= WIDTH:
+    raise ValueError("OEA requires positive width/batch size and 2 <= min_rows <= width")
+ARMED = K0 > 0
+_CONTEXT = ContextVar("oea_target_forward", default=None)
+_STATE = {}
+_LOCK = threading.RLock()
+_SERVING = threading.Event()  # set by mark_serving(); the control threads wait for it
+_warned_capture = False
+
+
+@contextmanager
+def target_forward_context(forward_batch):
+    if not ARMED or forward_batch is None:
+        yield
+        return
+    target_verify = forward_batch.forward_mode.is_target_verify()
+    width = forward_batch.spec_info.draft_token_num if target_verify else 0
+    token = _CONTEXT.set((target_verify, width, forward_batch.batch_size))
+    try:
+        yield
+    finally:
+        _CONTEXT.reset(token)
+
+
+def initial_config():
+    # prune_singleton exports these before the first MoE call; explicit FlashInfer values win.
+    tau = float(os.environ.get("FLASHINFER_MOE_PRUNE_SINGLETON_TAU", "0"))
+    return dict(
+        mode=MODE, k0=K0, min_rows=MIN_ROWS, tau=0.0, renorm=0, fallback=1,
+        prod_tau=tau if tau > 0 else 0.0,
+        prod_min_rank=max(1, int(os.environ.get("FLASHINFER_MOE_PRUNE_MIN_RANK", "1"))),
+        prod_min_rows=int(os.environ.get("FLASHINFER_MOE_PRUNE_MIN_ROWS", "2")),
+    )
+
+
+def _state(device):
+    global _warned_capture
+    device = torch.device(device)
+    st = _STATE.get(device)
+    if st is not None:
+        return st
+    if device.type == "cuda" and torch.cuda.is_current_stream_capturing():
+        if not _warned_capture:
+            _warned_capture = True
+            logger.warning("OEA state was not allocated before CUDA graph capture; omitting pointers")
+        return None
+    with _LOCK:
+        if device not in _STATE:
+            cfg = initial_config()
+            _STATE[device] = dict(
+                cell=torch.tensor(_cell_values(cfg), dtype=torch.int32, device=device),
+                stats=torch.zeros(8, dtype=torch.float64, device=device),
+                cfg_host=cfg, seq=None,
+            )
+            if CTL_FILE:
+                _start_ctl_thread(device, _STATE[device])
+    return _STATE[device]
+
+
+def _cell_values(cfg):
+    """{k0, min_rows} as the kernel reads them; mode prod writes k0 = 0 (production prune)."""
+    return [cfg["k0"] if cfg["mode"] == "oea" else 0, cfg["min_rows"]]
+
+
+def _write_cell(cell, cfg):
+    """Both words with one store: the int32[2] cell viewed as one int64 and filled once. The kernel reads the two
+    words with two 32-bit loads, so a store between them can still mix a pair, but the window shrinks from the gap
+    between two kernel launches to the gap between two adjacent loads (every mixed pair is a valid setting)."""
+    packed = torch.tensor(_cell_values(cfg), dtype=torch.int32).view(torch.int64).item()
+    cell.view(torch.int64).fill_(packed)
+
+
+def mark_serving():
+    """The process has captured all its CUDA graphs (run_scheduler_process, after Scheduler(...) returned): the control
+    threads may read the control file from now on. Idempotent; no allocation, no CUDA call."""
+    _SERVING.set()
+
+
+def call_kwargs(num_rows, *, device=None):
+    if not ARMED:
+        return {}
+    device = torch.device("cuda", torch.cuda.current_device()) if device is None else device
+    st = _state(device)
+    if st is None:
+        return {}
+    out = {"oea_stats": st["stats"]} if STATS else {}
+    ctx = _CONTEXT.get()
+    if ctx is not None:
+        verify, width, bs = ctx
+        # The row gate itself is in the kernel (live rows >= cell[1], switchable at run time). This host check must not
+        # read the run-time value: CUDA graphs keep whatever pointer the capture passed.
+        if verify and width == WIDTH and bs <= MAX_BS and num_rows >= 2:
+            out["oea_k0"] = st["cell"]
+    return out
+
+
+def read_stats(dev=None):
+    if not _STATE:
+        return None
+    dev = torch.device(dev) if dev is not None else next(iter(_STATE))
+    stats = _STATE[dev]["stats"]
+    return dict(zip(STAT_NAMES, stats.detach().cpu().tolist()))
+
+
+def parse_ctl(text):
+    conv = dict(seq=int, mode=str, k0=int, tau=float, renorm=int, min_rows=int,
+                fallback=int, prod_tau=float, prod_min_rank=int, prod_min_rows=int, snap=int)
+    out = {}
+    for tok in text.split():
+        if "=" not in tok:
+            raise ValueError(f"bad token {tok!r}")
+        key, value = tok.split("=", 1)
+        if key not in conv or key in out:
+            raise ValueError(f"unknown or repeated key {key!r}")
+        out[key] = conv[key](value)
+    if "seq" not in out:
+        raise ValueError("missing seq=")
+    return out
+
+
+def _validated_config(req, current):
+    cfg = dict(current)
+    cfg.update({k: v for k, v in req.items() if k not in {"seq", "snap"}})
+    if cfg["mode"] not in {"oea", "prod"} or not 1 <= cfg["k0"] <= 9:
+        raise ValueError("unsupported mode or k0")
+    if not 2 <= cfg["min_rows"] <= WIDTH:
+        raise ValueError(f"unsupported min_rows={cfg['min_rows']!r}; allowed 2..{WIDTH}")
+    fixed = dict(tau=0, renorm=0, fallback=1,
+                 prod_tau=current["prod_tau"], prod_min_rank=current["prod_min_rank"],
+                 prod_min_rows=current["prod_min_rows"])
+    for key, value in fixed.items():
+        if cfg[key] != value:
+            raise ValueError(f"unsupported {key}={cfg[key]!r}; effective value is {value!r}")
+    return cfg
+
+
+def apply_control(text, device, st):
+    rec = dict(pid=os.getpid(), t=time.time())
+    try:
+        seq_values = [tok[4:] for tok in text.split() if tok.startswith("seq=")]
+        if len(seq_values) != 1:
+            raise ValueError("expected exactly one seq=")
+        seq = int(seq_values[0])
+        rec["seq"] = seq
+        if seq == st["seq"]:
+            return None
+        # Rejected sequences are recorded once, without changing configuration or device state.
+        st["seq"] = seq
+        req = parse_ctl(text)
+        cfg = _validated_config(req, st["cfg_host"])
+        if device.type == "cuda":
+            torch.cuda.synchronize(device)
+        snap = read_stats(device)
+        if device.type == "cuda":
+            with torch.cuda.device(device), torch.cuda.stream(torch.cuda.Stream(device)):
+                _write_cell(st["cell"], cfg)
+                torch.cuda.current_stream().synchronize()
+        else:
+            _write_cell(st["cell"], cfg)
+        st["cfg_host"] = cfg
+        rec.update(cfg=cfg, stats=snap)
+    except (ValueError, RuntimeError) as exc:
+        rec.update(error=str(exc), text=text, cfg=dict(st["cfg_host"]), stats=read_stats(device))
+    return rec
+
+
+def _write_status(ctl_file, rec):
+    try:
+        with open(ctl_file + ".status.jsonl", "a") as f:
+            f.write(json.dumps(rec) + "\n")
+    except OSError:
+        logger.exception("Could not write OEA control status")
+
+
+def _start_ctl_thread(device, st):
+    ctl_file, serving = CTL_FILE, _SERVING  # bound at start (a module reload must not move a running thread)
+
+    def loop():
+        # oea-sd: one start record (no seq), so `oea status` shows k0/min_rows before the first switch.
+        with _LOCK:
+            _write_status(ctl_file, dict(pid=os.getpid(), t=time.time(), start=True, cfg=dict(st["cfg_host"])))
+        # The first MoE call is the start's FlashInfer autotune (EagerRunner, before any graph runner); the target,
+        # draft and adaptive graphs are captured after it. apply_control synchronizes the device, which would
+        # invalidate a capture on the forward thread: read nothing until mark_serving().
+        serving.wait()
+        with _LOCK:
+            _write_status(ctl_file, dict(pid=os.getpid(), t=time.time(), serving=True, cfg=dict(st["cfg_host"])))
+        last = None
+        while True:
+            time.sleep(0.25)
+            try:
+                with open(ctl_file) as f:
+                    text = f.read().strip()
+            except OSError:
+                continue
+            if not text or text == last:
+                continue
+            last = text
+            with _LOCK:
+                rec = apply_control(text, device, st)
+            if rec is not None:
+                _write_status(ctl_file, rec)
+    threading.Thread(target=loop, daemon=True, name="oea-ctl").start()
diff --git a/python/sglang/srt/layers/moe/prune_singleton.py b/python/sglang/srt/layers/moe/prune_singleton.py
new file mode 100644
index 000000000..e65bb475f
--- /dev/null
+++ b/python/sglang/srt/layers/moe/prune_singleton.py
@@ -0,0 +1,345 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 aiueo52 and contributors
+
+"""P1: drop routed-expert routes that are the sole user of their expert.
+
+The routed-expert grouped GEMM is at the expert-weight bandwidth roof and costs
+~1.04 us per *distinct* expert per call (GEMM1 = 9.4 + 1.036*D us at T=4, GEMM2
+~0.55x that; ``specs/G1_LOG.md``).  At T=16 about half the ~69 distinct experts
+of a verify call are **singletons** -- reached by exactly one of the 16 chain
+rows (``specs/MOE_SMALLM_SPEC.md`` 8.2, columns x1/x2/>=3).  Dropping a
+singleton route removes a whole expert weight read (2.76 MB, ~1.6 us of
+GEMM1+GEMM2); dropping a route to an expert some *other* row also uses saves
+nothing at all, because that expert's weights are read either way.  A uniform
+top-k cut cannot exploit that asymmetry; this can.
+
+``SGLANG_MOE_PRUNE_SINGLETON_TAU=<float>`` (default 0 = off) masks every route
+that is, within the current MoE call's batch,
+
+* the only route to its expert, **and**
+* below ``tau`` in normalised routing weight, **and**
+* not the row's top-1 (``SGLANG_MOE_PRUNE_MIN_RANK``, default 1) -- a row must
+  keep at least one expert or FlashInfer's finalize never writes its output.
+
+A masked route gets expert id ``-1`` and weight 0.  FlashInfer treats any id
+outside ``[start_expert, end_expert)`` as "not on this node": the fused prologue
+sorts it into the ``num_experts_per_node`` bucket, so it lands past
+``expert_first_token_offset[num_experts_per_node]`` -- the ``num_valid_tokens``
+bound that ``expandInputRowsKernel`` and both finalize paths loop to -- and the
+non-filling finalize skips it explicitly (``expert_id < 0`` in
+``finalizeMoeRoutingNoFillingKernel``).  Nothing downstream has to change, and
+the group-packing patch (``FLASHINFER_MOE_PACK_GROUPS``) keeps working because
+its group list bound ``expanded_num_rows = num_tokens * k`` stays an upper
+bound.  ``-1`` rather than ``num_experts`` as the sentinel so it can never
+collide with a fused shared-expert slot at index ``num_experts``.
+
+Everything runs in one single-CTA Triton kernel over the ``[M, k]`` top-k
+tensors, in place, with no host sync and no allocation, so it is CUDA-graph
+capturable.  Only ``[min_rows, max_rows]`` batches are touched (default 2..64),
+which keeps the T=1 draft/decode calls -- where every route is a singleton by
+construction, i.e. a plain top-k cut -- and prefill out of it.
+
+VT supplies an optional device length L. Only rows < min(M, L+1) participate
+in either count implementation; MIN_ROWS/MAX_ROWS use that effective size too.
+Thus live routes match an actual short verify, even when dead-row hidden states
+change in later layers. Dead rows are always written as id -1 / weight 0.
+
+Env:
+    SGLANG_MOE_PRUNE_SINGLETON_TAU   weight threshold; 0/unset disables (default 0)
+    SGLANG_MOE_PRUNE_MIN_RANK        lowest 0-based within-row rank eligible (default 1)
+    SGLANG_MOE_PRUNE_MIN_ROWS        smallest batch to prune (default 2)
+    SGLANG_MOE_PRUNE_MAX_ROWS        largest batch to prune (default 64)
+    SGLANG_MOE_PRUNE_RENORM          rescale each row's surviving weights to sum 1 (default 0)
+    SGLANG_MOE_PRUNE_KEEP_IDS        zero the weight but keep the id (equivalence control, default 0)
+    SGLANG_MOE_PRUNE_PAIRWISE        O(N^2) reference path instead of the histogram (default 0)
+    SGLANG_MOE_PRUNE_WARPS           num_warps for the kernel (default 4)
+    SGLANG_MOE_PRUNE_NUM_EXPERTS     histogram width; must exceed every expert id (default 512)
+    SGLANG_MOE_PRUNE_IN_PROLOGUE     P2: hand the mask to FlashInfer's fused routing prologue
+                                     (patched csrc, ``FLASHINFER_MOE_PRUNE_SINGLETON_TAU``) and
+                                     skip this kernel entirely (default 0)
+
+P2 (``SGLANG_MOE_PRUNE_IN_PROLOGUE=1``): the same rule evaluated inside FlashInfer's
+``fusedBuildExpertMapsSortFirstTokenAndStridesKernel`` (private csrc patch
+``p2-prune-in-prologue.patch``), which already reads the top-k ids, so the prune
+costs no launch and -- the point -- does not cost the prologue the ~54 % of its
+time that is otherwise hidden behind the preceding kernels (``specs/P1_LOG.md``
+step 6/7).  ``TAU``/``MIN_RANK``/``MIN_ROWS``/``MAX_ROWS`` are exported to the
+``FLASHINFER_MOE_PRUNE_*`` variables the csrc reads (an explicitly set
+``FLASHINFER_`` value wins), and this module's kernel becomes a no-op.  The csrc
+writes the dropped routes back as id -1 / weight 0, the same convention as here.
+Without VT, a call the fused prologue declines (batch > 32 rows, unsupported
+quant path, ``FLASHINFER_MOE_FUSED_PROLOGUE=0`` ...) is not pruned, as before.
+With VT, the patched FlashInfer (flashinfer-overlays) uses a live-only standalone fallback.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.kernels.triton_pdl import PDL, pdl_trigger, pdl_wait
+
+logger = logging.getLogger(__name__)
+
+SENTINEL = -1
+
+
+def _f(name: str, default: str) -> float:
+    return float(os.environ.get(name, default) or default)
+
+
+def _i(name: str, default: str) -> int:
+    return int(os.environ.get(name, default) or default)
+
+
+def _b(name: str, default: str) -> bool:
+    return os.environ.get(name, default).lower() in ("1", "true", "yes", "on")
+
+
+TAU = _f("SGLANG_MOE_PRUNE_SINGLETON_TAU", "0")
+MIN_RANK = _i("SGLANG_MOE_PRUNE_MIN_RANK", "1")
+MIN_ROWS = _i("SGLANG_MOE_PRUNE_MIN_ROWS", "2")
+MAX_ROWS = _i("SGLANG_MOE_PRUNE_MAX_ROWS", "64")
+RENORM = _b("SGLANG_MOE_PRUNE_RENORM", "0")
+# Equivalence control: zero the weight but keep the expert id.  The MoE output
+# is then mathematically identical to real pruning (a zero-weight route adds
+# nothing in the finalize) while the grouped GEMM still reads every expert, so
+# an A/B against the real thing isolates "is the -1 sentinel handled correctly"
+# from "does dropping the route change the answer".
+KEEP_IDS = _b("SGLANG_MOE_PRUNE_KEEP_IDS", "0")
+PAIRWISE = _b("SGLANG_MOE_PRUNE_PAIRWISE", "0")
+NUM_WARPS = _i("SGLANG_MOE_PRUNE_WARPS", "4")
+# Upper bound on expert ids, i.e. the histogram width.  512 for this model;
+# raised via the env if a wider router ever uses this path.
+NUM_EXPERT_SLOTS = _i("SGLANG_MOE_PRUNE_NUM_EXPERTS", "512")
+IN_PROLOGUE = _b("SGLANG_MOE_PRUNE_IN_PROLOGUE", "0")
+# P2: the C++ side reads its knobs once, on the first MoE call, via getenv; os.environ
+# writes reach it through putenv, and this module is imported long before that call.
+if TAU > 0.0 and IN_PROLOGUE:
+    for _k, _v in (
+        ("FLASHINFER_MOE_PRUNE_SINGLETON_TAU", repr(TAU)),
+        ("FLASHINFER_MOE_PRUNE_MIN_RANK", str(MIN_RANK)),
+        ("FLASHINFER_MOE_PRUNE_MIN_ROWS", str(MIN_ROWS)),
+        ("FLASHINFER_MOE_PRUNE_MAX_ROWS", str(MAX_ROWS)),
+    ):
+        os.environ.setdefault(_k, _v)
+    if RENORM or KEEP_IDS:
+        logger.warning("moe prune: RENORM/KEEP_IDS are not available in the in-prologue path")
+# The Triton kernel runs only when pruning is on *and* not delegated to FlashInfer.
+ENABLED = TAU > 0.0 and not IN_PROLOGUE
+
+_warned: set = set()
+# Per-device [NUM_EXPERT_SLOTS] int32 histogram scratch, allocated eagerly on the
+# first non-capturing call and always left zeroed by the kernel.
+_COUNTS: dict = {}
+
+
+@triton.jit
+def _prune_singleton_kernel(
+    ids_ptr,
+    w_ptr,
+    cnt_ptr,
+    vt_lens_ptr,
+    M,
+    TAU_,
+    MIN_RANK_,
+    MIN_ROWS_: tl.constexpr,
+    MAX_ROWS_: tl.constexpr,
+    HAS_VT: tl.constexpr,
+    K: tl.constexpr,
+    MP: tl.constexpr,
+    KP: tl.constexpr,
+    SENTINEL_: tl.constexpr,
+    KEEP_IDS_: tl.constexpr,
+    PAIRWISE_: tl.constexpr,
+    USE_PDL: tl.constexpr,
+    BS: tl.constexpr = 1,
+):
+    """One CTA over the [M, k] top-k tile of a single MoE call.
+
+    ``rank`` -- routes in the same row with a strictly larger weight (column
+    index breaks ties), i.e. the 0-based within-row rank.  Computed from a
+    per-row k x k compare, so it is exact and costs only ``M*k*k`` register ops
+    (1 280 at T=16, k=10) -- no dependence on the order ``topk`` happened to
+    store the ids in.
+
+    ``cnt`` -- how many rows of this call route to the same expert; ``cnt == 1``
+    is a singleton.  Two ways to get it:
+
+    * default: a **device histogram** over the E expert slots in ``cnt_ptr``.
+      ``atomic_add`` -> ``__syncthreads`` -> gather -> ``atomic_xchg`` back to
+      zero, so the buffer is always zero on entry and never has to be cleared
+      with a plain store (a store would land in this SM's L1 while the atomics
+      go to L2, and the gather could then read a stale line).  The gather is
+      ``.cg`` for the same reason.  O(N).
+    * ``PAIRWISE_``: the O(N^2/CHUNK) all-pairs compare, kept as a reference
+      for the unit test and as a fallback if the scratch buffer cannot be
+      allocated eagerly.
+
+    Everything is one CTA, so ``tl.debug_barrier`` is a plain ``__syncthreads``
+    and there is no inter-CTA race between the loads and the in-place stores.
+    """
+    pdl_wait(USE_PDL)
+    r = tl.arange(0, MP)
+    c = tl.arange(0, KP)
+    off = r[:, None] * K + c[None, :]
+    live_rows = M
+    live = r < M
+    can_prune = True
+    if HAS_VT:
+        if BS == 1:
+            live_rows = tl.minimum(M, tl.maximum(tl.load(vt_lens_ptr), 0) + 1)
+            live = r < live_rows
+        else:
+            rowsper = M // BS
+            cap = tl.maximum(
+                tl.load(vt_lens_ptr + r // rowsper, mask=r < M, other=-1), 0
+            )
+            live = (r < M) & (r % rowsper <= cap)
+            live_rows = tl.sum(live.to(tl.int32), axis=0)
+        can_prune = (live_rows >= MIN_ROWS_) & (live_rows <= MAX_ROWS_)
+    physical = (r[:, None] < M) & (c[None, :] < K)
+    m = live[:, None] & (c[None, :] < K)
+    ids = tl.load(ids_ptr + off, mask=m, other=SENTINEL_)
+    w = tl.load(w_ptr + off, mask=m, other=0.0).to(tl.float32)
+
+    # within-row rank: [MP, KP, KP]
+    gt = (w[:, None, :] > w[:, :, None]) | (
+        (w[:, None, :] == w[:, :, None]) & (c[None, None, :] < c[None, :, None])
+    )
+    rank = tl.sum((gt & m[:, None, :]).to(tl.int32), axis=2)
+
+    if PAIRWISE_:
+        cnt = tl.zeros([MP, KP], tl.int32)
+        for rp in tl.static_range(MP):
+            if HAS_VT and BS > 1:
+                rp_cap = tl.maximum(
+                    tl.load(vt_lens_ptr + rp // rowsper, mask=rp < M, other=-1), 0
+                )
+                rp_live = (rp < M) & (rp % rowsper <= rp_cap)
+            else:
+                rp_live = rp < live_rows
+            orow = tl.load(ids_ptr + rp * K + c, mask=(c < K) & rp_live,
+                           other=SENTINEL_ - 1)
+            cnt += tl.sum((ids[:, :, None] == orow[None, None, :]).to(tl.int32),
+                          axis=2)
+    else:
+        valid_id = m & (ids >= 0) if HAS_VT else m
+        tl.atomic_add(cnt_ptr + ids, 1, mask=valid_id)
+        tl.debug_barrier()
+        cnt = tl.load(cnt_ptr + ids, mask=valid_id, other=0, cache_modifier=".cg")
+        tl.debug_barrier()
+        tl.atomic_xchg(cnt_ptr + ids, 0, mask=valid_id)
+
+    prune = m & can_prune & (cnt == 1) & (w < TAU_) & (rank >= MIN_RANK_)
+    tl.debug_barrier()          # every load above precedes every store below
+    if not KEEP_IDS_ or HAS_VT:
+        out_ids = ids if KEEP_IDS_ else tl.where(prune, SENTINEL_, ids)
+        tl.store(ids_ptr + off, out_ids, mask=physical)
+    tl.store(w_ptr + off, tl.where(prune, 0.0, w).to(w_ptr.dtype.element_ty), mask=physical)
+    pdl_trigger(USE_PDL)
+
+
+def _skip(reason: str) -> None:
+    if reason not in _warned:
+        _warned.add(reason)
+        logger.warning("moe singleton prune disabled for this shape: %s", reason)
+
+
+def maybe_prune_singleton_routes(
+    topk_ids: torch.Tensor, topk_weights: torch.Tensor, vt_lens: torch.Tensor | None = None
+) -> None:
+    """In-place singleton mask, counting only VT's live rows when supplied."""
+    if not ENABLED:
+        return
+    prune_singleton_routes_(topk_ids, topk_weights, TAU, MIN_RANK, MIN_ROWS, MAX_ROWS, vt_lens)
+
+
+def prune_singleton_routes_(
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    tau: float,
+    min_rank: int = 1,
+    min_rows: int = 2,
+    max_rows: int = 64,
+    vt_lens: torch.Tensor | None = None,
+) -> None:
+    """The kernel itself, independent of the env gating (used by the P2 equivalence test)."""
+    if topk_ids.dim() != 2 or topk_weights.shape != topk_ids.shape:
+        return _skip(f"shape {tuple(topk_ids.shape)}/{tuple(topk_weights.shape)}")
+    M, K = topk_ids.shape
+    if M == 0 or (vt_lens is None and (M < min_rows or M > max_rows)):
+        return
+    bs = 1
+    if vt_lens is not None:
+        if (
+            vt_lens.dim() != 1 or vt_lens.numel() < 1 or vt_lens.dtype != torch.int32
+            or not vt_lens.is_contiguous() or not vt_lens.is_cuda
+            or vt_lens.device != topk_ids.device
+        ):
+            raise ValueError("VT singleton pruning requires CUDA int32 [bs] lengths on the route device")
+        bs = vt_lens.numel()
+        if bs > 1 and (M < bs or M % bs != 0):
+            raise ValueError("VT singleton pruning requires nonempty equal-sized per-request rows")
+    if not (topk_ids.is_contiguous() and topk_weights.is_contiguous()):
+        return _skip("non-contiguous top-k tensors")
+    dev = topk_ids.device
+    cnt = _COUNTS.get(dev)
+    if cnt is None:
+        # The histogram scratch must not be allocated inside a CUDA graph
+        # capture (it would land in that graph's private pool).  SGLang runs two
+        # eager warmup forwards per batch size before every capture, so this
+        # always fires on an eager call; the pairwise path is the safety net.
+        if torch.cuda.is_current_stream_capturing():
+            _skip("scratch not allocated before capture; using pairwise")
+        else:
+            cnt = torch.zeros(NUM_EXPERT_SLOTS, dtype=torch.int32, device=dev)
+            _COUNTS[dev] = cnt
+    MP = triton.next_power_of_2(M)
+    KP = triton.next_power_of_2(K)
+    _prune_singleton_kernel[(1,)](
+        topk_ids,
+        topk_weights,
+        cnt if cnt is not None else topk_ids,   # unused when PAIRWISE_
+        vt_lens if vt_lens is not None else topk_ids,
+        M,
+        tau,
+        min_rank,
+        MIN_ROWS_=min_rows,
+        MAX_ROWS_=max_rows,
+        HAS_VT=vt_lens is not None,
+        BS=bs,
+        K=K,
+        MP=MP,
+        KP=KP,
+        SENTINEL_=SENTINEL,
+        KEEP_IDS_=KEEP_IDS,
+        PAIRWISE_=PAIRWISE or cnt is None,
+        USE_PDL=PDL,
+        num_warps=NUM_WARPS,
+        launch_pdl=PDL,
+    )
+    if RENORM:
+        denominator = topk_weights.sum(dim=-1, keepdim=True).clamp_min(1e-6)
+        if vt_lens is not None:
+            # A physical one-row call skips normalization together with pruning.
+            if bs == 1:
+                live_rows = (vt_lens.clamp_min(0) + 1).clamp_max(M)
+            else:
+                live_rows = (vt_lens.clamp_min(0) + 1).clamp_max(M // bs).sum()
+            denominator = torch.where(
+                (live_rows >= min_rows) & (live_rows <= max_rows), denominator, 1.0
+            )
+        topk_weights.div_(denominator)
+
+
+def describe() -> str:
+    return (
+        f"tau={TAU} min_rank={MIN_RANK} rows=[{MIN_ROWS},{MAX_ROWS}] "
+        f"renorm={RENORM} keep_ids={KEEP_IDS} pairwise={PAIRWISE} "
+        f"warps={NUM_WARPS} in_prologue={IN_PROLOGUE}"
+    )
diff --git a/python/sglang/srt/layers/moe/router_gemv.py b/python/sglang/srt/layers/moe/router_gemv.py
new file mode 100644
index 000000000..a91f0313d
--- /dev/null
+++ b/python/sglang/srt/layers/moe/router_gemv.py
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 aiueo52 and contributors
+
+"""Small-batch BF16 router projection for Qwen MoE decode/verify."""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _router_gemv_kernel(
+    x_ptr,
+    weight_ptr,
+    bias_ptr,
+    out_ptr,
+    m,
+    K: tl.constexpr,
+    N: tl.constexpr,
+    HAS_BIAS: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    n = tl.program_id(0) * BLOCK_N + tl.arange(0, BLOCK_N)
+    rows = tl.arange(0, BLOCK_M)
+    row_mask = rows < m
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+
+    for k0 in range(0, K, BLOCK_K):
+        k = k0 + tl.arange(0, BLOCK_K)
+        x = tl.load(
+            x_ptr + rows[:, None] * K + k[None, :],
+            mask=row_mask[:, None],
+            other=0.0,
+        )
+        weight = tl.load(weight_ptr + n[:, None] * K + k[None, :])
+        acc += tl.dot(x, tl.trans(weight), out_dtype=tl.float32)
+
+    if HAS_BIAS:
+        acc += tl.load(bias_ptr + n)[None, :].to(tl.float32)
+    tl.store(
+        out_ptr + rows[:, None] * N + n[None, :],
+        acc,
+        mask=row_mask[:, None],
+    )
+
+
+def router_gemv(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Compute ``x @ weight.T + bias`` into an FP32 router-logit tensor."""
+    if x.dim() != 2 or weight.dim() != 2:
+        raise ValueError("x and weight must be 2-D")
+    m, k = x.shape
+    n, weight_k = weight.shape
+    if not 1 <= m <= 16:
+        raise ValueError("router GEMV requires 1 <= M <= 16")
+    if k != weight_k or k % 128 != 0 or n % 32 != 0:
+        raise ValueError("router GEMV requires matching K % 128 == 0 and N % 32 == 0")
+    tensors = (x, weight) if bias is None else (x, weight, bias)
+    if any(not tensor.is_cuda for tensor in tensors):
+        raise ValueError("router GEMV requires CUDA tensors")
+    if any(tensor.device != x.device for tensor in tensors):
+        raise ValueError("all router GEMV tensors must be on the same device")
+    if x.dtype != torch.bfloat16 or weight.dtype != torch.bfloat16:
+        raise ValueError("router GEMV supports BF16 inputs and weights only")
+    if not x.is_contiguous() or not weight.is_contiguous():
+        raise ValueError("router GEMV inputs and weights must be contiguous")
+    if bias is not None:
+        if bias.shape != (n,) or bias.dtype != torch.bfloat16:
+            raise ValueError("router GEMV bias must be contiguous BF16 with shape [N]")
+        if not bias.is_contiguous():
+            raise ValueError("router GEMV bias must be contiguous")
+
+    out = torch.empty((m, n), dtype=torch.float32, device=x.device)
+    bias_arg = bias if bias is not None else weight
+    _router_gemv_kernel[(n // 32,)](
+        x,
+        weight,
+        bias_arg,
+        out,
+        m,
+        K=k,
+        N=n,
+        HAS_BIAS=bias is not None,
+        BLOCK_M=16,
+        BLOCK_N=32,
+        BLOCK_K=256,
+        num_warps=8,
+    )
+    return out
