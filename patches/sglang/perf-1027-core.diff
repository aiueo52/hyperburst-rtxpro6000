+        # Window state after consuming token t: the last KERNEL_WIDTH-1 inputs,
+        # i.e. slot i holds x[t - (KERNEL_WIDTH-2) + i] == matrix_x{i+1}.
+        # Layout: [seq(cache line), step, dim, win(K-1)]
