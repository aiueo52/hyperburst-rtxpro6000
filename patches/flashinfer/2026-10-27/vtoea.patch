+        if (expand_permuted_scales && threadIdx.x == 0) {
+          int64_t const source_k_idx = source_row * EXPERTS_PER_TOKEN + source_k_rank;
+          expand_permuted_scales[permuted_row] =
+              expand_unpermuted_scales ? expand_unpermuted_scales[source_k_idx] : 1.0f;
+        }
