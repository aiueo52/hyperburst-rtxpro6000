+//
+// The fusion keeps the strides phase exactly as parallel as it was (grid = ceil(E/32) blocks of
+// 32 threads, one thread per expert).  Every block re-runs the (cheap, deterministic) prologue so
+// that no grid-wide barrier is needed; only block 0 writes the routing maps to global memory.
+//
+// Restricted to BLOCK_SIZE = 32 (num_tokens <= 32, i.e. decode/verify) and LOG2_NUM_EXPERTS = 10
+// (num_experts_per_node + 1 < 1024) to keep the instantiation count to one per top-k value per
+// runner type.  Everything else falls back to the two separate launches.
+// G2-2: the maximum number of 8-element chunks one thread stages per row.  hidden_size /
+// (8 * BLOCK_SIZE) must be <= this; the host gate refuses the fusion otherwise.
+constexpr int G2_EXPAND_MAX_CHUNKS = 16;
+// RQ2: chunks per trip of the expand quantize loop (a build-time choice; FC_fc-moe 1d).
+#ifndef G2_EXPAND_QUANT_UNROLL
+#define G2_EXPAND_QUANT_UNROLL 2
+#endif
+// RQ2h: 1 = compute the row's SF write address once instead of once per chunk (FC_fc-moe 1d).
+#ifndef G2_EXPAND_SF_HOIST
+#define G2_EXPAND_SF_HOIST 0
+#endif
+
+// RQ2: one 16-byte global -> shared copy that holds no registers while in flight (cached in L2
+// only), and the wait for all of this thread's copies.
+__device__ __forceinline__ void g2CpAsync16(void* smem_dst, void const* gmem_src) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 800
+  uint32_t const dst = static_cast<uint32_t>(__cvta_generic_to_shared(smem_dst));
+  asm volatile("cp.async.cg.shared.global [%0], [%1], 16;\n" ::"r"(dst), "l"(gmem_src) : "memory");
+#else
+  *static_cast<uint4*>(smem_dst) = *static_cast<uint4 const*>(gmem_src);
+#endif
+}
+
+__device__ __forceinline__ void g2CpAsyncWaitAll() {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 800
+  asm volatile("cp.async.wait_all;\n" ::: "memory");
+#endif
+}
+
+// Keep the length on device (including during CUDA graph replay).  Widen before adding
+// the mandatory verifier row, so even INT32_MAX is safe.
+__device__ __forceinline__ int64_t moeVtActiveRows(int64_t num_tokens, int const* vt_lens,
+                                                int vt_batch_size) {
+  if (vt_lens == nullptr) return num_tokens;
+  int64_t const rows_per_request = num_tokens / vt_batch_size;
+  int64_t active_rows = 0;
+  for (int request = 0; request < vt_batch_size; ++request) {
+    int64_t const len = vt_lens[request];
+    int64_t const rows = (len > 0 ? len : 0) + 1;
+    active_rows += rows < rows_per_request ? rows : rows_per_request;
+  }
+  return active_rows;
+}
+
+__device__ __forceinline__ bool moeVtIsActiveRow(int64_t row, int64_t num_tokens,
+                                               int const* vt_lens, int vt_batch_size) {
+  if (row < 0 || row >= num_tokens) return false;
+  if (vt_lens == nullptr) return true;
+  int64_t const rows_per_request = num_tokens / vt_batch_size;
+  int64_t const len = vt_lens[row / rows_per_request];
+  int64_t const rows = (len > 0 ? len : 0) + 1;
+  return row % rows_per_request < rows;
+}
+
+// The legacy routing kernels accept id -1, but cannot consume a device row count.
+// If A3 declines with pruning off, only the per-request tail mask needs a standalone launch.
+__global__ void maskMoeVtTailKernel(int* ids, float* scales, int64_t num_tokens,
+                                   int experts_per_token, int const* vt_lens, int vt_batch_size) {
+  int64_t const routes = num_tokens * experts_per_token;
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+       i < routes; i += static_cast<int64_t>(blockDim.x) * gridDim.x) {
+    if (!moeVtIsActiveRow(i / experts_per_token, num_tokens, vt_lens, vt_batch_size)) {
+      ids[i] = -1;
+      scales[i] = 0.f;
+    }
+  }
+}
+
+// VT fallback: stage decisions without modifying the source ids/weights.  This keeps
+// singleton counts strictly pre-prune across CTAs.  The otherwise-unused permutation-id
+// workspace supplies one int per route; no allocation or host length read is needed.
+__global__ void prepareMoeVtPruneKernel(
+    int const* ids, float const* scales, int* prepared_ids, int64_t num_tokens,
+    int experts_per_token, int num_experts, int const* vt_lens, int vt_batch_size, float tau,
+    int min_rank, int min_rows, int max_rows) {
+  int64_t const active_rows = moeVtActiveRows(num_tokens, vt_lens, vt_batch_size);
+  bool const prune = tau > 0.f && min_rank < experts_per_token &&
+                     active_rows >= min_rows && active_rows <= max_rows;
+  int64_t const routes = num_tokens * experts_per_token;
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+       i < routes; i += static_cast<int64_t>(blockDim.x) * gridDim.x) {
+    int64_t const row = i / experts_per_token;
+    if (!moeVtIsActiveRow(row, num_tokens, vt_lens, vt_batch_size)) {
+      prepared_ids[i] = -1;
+      continue;
+    }
+    int const expert = ids[i];
+    bool drop = false;
+    if (prune && expert >= 0 && expert < num_experts && scales[i] < tau) {
+      int const slot = i % experts_per_token;
+      int rank = 0;
+      float const weight = scales[i];
+      for (int j = 0; j < experts_per_token; ++j) {
+        float const other = scales[row * experts_per_token + j];
+        rank += (other > weight || (other == weight && j < slot)) ? 1 : 0;
+      }
+      if (rank >= min_rank) {
+        int count = 0;
+        for (int64_t j = 0; j < routes && count < 2; ++j) {
+          if (moeVtIsActiveRow(j / experts_per_token, num_tokens, vt_lens, vt_batch_size) &&
+              ids[j] == expert) {
+            ++count;
+          }
+        }
+        drop = count == 1;
+      }
+    }
+    prepared_ids[i] = drop ? -1 : expert;
+  }
+}
+
+__global__ void applyMoeVtPruneKernel(int* ids, float* scales, int const* prepared_ids,
+                                     int64_t routes) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+       i < routes; i += static_cast<int64_t>(blockDim.x) * gridDim.x) {
+    int const expert = prepared_ids[i];
+    ids[i] = expert;
+    if (expert == -1) scales[i] = 0.f;
+  }
+}
+
+template <class T, class WeightType, class OutputType, class ScaleBiasType, class InputAct,
+          int BLOCK_SIZE, int EXPERTS_PER_TOKEN, int LOG2_NUM_EXPERTS, bool FUSE_EXPAND>
+__global__ void fusedBuildExpertMapsSortFirstTokenAndStridesKernel(
+    int const* const token_selected_experts, int* const permuted_row_to_unpermuted_row,
+    int* const unpermuted_row_to_permuted_row, int64_t* const expert_first_token_offset,
+    int64_t const num_tokens, int const start_expert, int const end_expert,
+    int const num_experts_per_node, TmaWarpSpecializedGroupedGemmInput layout_info1,
+    TmaWarpSpecializedGroupedGemmInput layout_info2, int64_t gemm1_n, int64_t gemm1_k,
+    int64_t gemm2_n, int64_t gemm2_k, T const* gemm1_in, T const* gemm2_in,
+    WeightType const* weights1, WeightType const* weights2, float const* alpha_scale_flat1,
+    float const* alpha_scale_flat2,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat1,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat2, QuantParams quant_params,
+    ScaleBiasType const* bias1, ScaleBiasType const* bias2, OutputType* gemm1_output,
+    OutputType* gemm2_output, float const* router_scales, G1PackParams g1, int stride_blocks,
+    InputAct const* expand_input, T* expand_output, float const* expand_unpermuted_scales,
+    float* expand_permuted_scales,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF* expand_act_sf_flat,
+    float const* expand_act_global_scale, bool expand_use_per_expert_act_scale,
+    int64_t expand_hidden_size, float prune_tau, int prune_min_rank, float const* prune_scales,
+    int* prune_ids_out, float* prune_scales_out, int const* vt_lens,
+    int prune_min_rows, int prune_max_rows, int vt_batch_size, int const* oea_k0,
+    double* oea_stats) {
+  using BlockRadixRank = FusedPrologueRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS>;
+  static_assert(BlockRadixRank::BINS_TRACKED_PER_THREAD * BLOCK_SIZE >= (1 << LOG2_NUM_EXPERTS));
+  static_assert(EXPERTS_PER_TOKEN <= 32, "P2 keeps the prune mask in one 32-bit word");
+  assert(num_experts_per_node < (1 << LOG2_NUM_EXPERTS));
+  assert(num_experts_per_node == (end_expert - start_expert));
+
+  extern __shared__ unsigned char temp_storage[];
+  auto& sort_temp = *reinterpret_cast<typename BlockRadixRank::TempStorage*>(temp_storage);
+  int* const shared_offsets =
+      reinterpret_cast<int*>(temp_storage + sizeof(typename BlockRadixRank::TempStorage));
+  // G2-2: the inverse permutation and the per-permuted-row expert id, published block-locally so
+  // the row expansion below needs neither a global round trip nor the binary search that
+  // expandInputRowsKernel pays.  Every block re-runs the rank, so no grid-wide barrier is needed.
+  int* const shared_inv_row = shared_offsets + (num_experts_per_node + 1);
+  int* const shared_inv_expert = shared_inv_row + BLOCK_SIZE * EXPERTS_PER_TOKEN;
+
+  int const token = threadIdx.x;
+  bool const is_valid_token = token < num_tokens;
+
+  int local_token_selected_experts[EXPERTS_PER_TOKEN];
+  int local_token_permuted_indices[EXPERTS_PER_TOKEN];
+
+#if (defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900))
+  cudaGridDependencySynchronize();
+#endif
+
+  int64_t const active_rows = moeVtActiveRows(num_tokens, vt_lens, vt_batch_size);
+  bool const is_active_token = moeVtIsActiveRow(token, num_tokens, vt_lens, vt_batch_size);
+
+#pragma unroll
+  for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+    int const expert = is_active_token ? token_selected_experts[token * EXPERTS_PER_TOKEN + i]
+                                      : num_experts_per_node;
+    bool is_valid_expert = is_active_token && expert >= start_expert && expert < end_expert;
+    local_token_selected_experts[i] = !is_valid_token   ? num_experts_per_node + 1
+                                      : is_valid_expert ? (expert - start_expert)
+                                                        : num_experts_per_node;
+  }
+
+  // ---- P2: singleton-route prune, applied to the keys *before* the rank ------------------
+  // A route is dropped when, within this call, it is the only route to its expert (pre-prune
+  // count == 1, from a block-local histogram), its routing weight is < prune_tau, and its
+  // within-row rank (routes of the same row with a larger weight, ties broken by slot index --
+  // the same rule as SGLang's P1 Triton kernel) is >= prune_min_rank.  Dropping means re-keying
+  // it to `num_experts_per_node`, the "not on this node" bucket, which the radix rank sorts past
+  // every real expert: the permutation, the expert offsets, the G1 packing and the G2-2 row
+  // expansion below then all see the pruned set with no further change.  The histogram borrows
+  // `shared_offsets`, which is dead until after RankKeys.  prune_tau <= 0 skips all of it.
+  unsigned prune_mask = 0u;
+  if (prune_tau > 0.f && active_rows >= prune_min_rows && active_rows <= prune_max_rows) {
+    float local_w[EXPERTS_PER_TOKEN];
+#pragma unroll
+    for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+      local_w[i] = is_active_token ? prune_scales[token * EXPERTS_PER_TOKEN + i] : 0.f;
+    }
+    // oea-sd: oea_k0 = {k0, min_rows}.  OEA runs only when at least min_rows rows take part:
+    // the VT live rows 0..L when vt_lens is set, every row otherwise (active_rows == num_tokens).
+    int const k0 = oea_k0 ? oea_k0[0] : 0;
+    int const oea_min_rows = oea_k0 ? oea_k0[1] : 0;
+    bool const oea_applied =
+        k0 > 0 && k0 < EXPERTS_PER_TOKEN && active_rows >= static_cast<int64_t>(oea_min_rows);
+    unsigned valid_mask = 0u;
+#pragma unroll
+    for (int i = 0; i < EXPERTS_PER_TOKEN; ++i) {
+      if (local_token_selected_experts[i] < num_experts_per_node) valid_mask |= 1u << i;
+    }
+    if (oea_applied) {
+      for (int e = threadIdx.x; e < num_experts_per_node; e += BLOCK_SIZE) shared_offsets[e] = 0;
+      __syncthreads();
+#pragma unroll
+      for (int i = 0; i < EXPERTS_PER_TOKEN; ++i) {
+        if (valid_mask & (1u << i)) {
+          int rank = 0;
+#pragma unroll
+          for (int j = 0; j < EXPERTS_PER_TOKEN; ++j) {
+            rank += (valid_mask & (1u << j)) &&
+                    (local_w[j] > local_w[i] || (local_w[j] == local_w[i] && j < i));
+          }
+          if (rank < k0) atomicExch(&shared_offsets[local_token_selected_experts[i]], 1);
+        }
+      }
+      __syncthreads();
+      // Write-back cannot change U: dropped routes are never base and every base route
+      // in the same row outranks them. Their -1 ids or zero weights leave base ranks and keys unchanged.
+#pragma unroll
+      for (int i = 0; i < EXPERTS_PER_TOKEN; ++i) {
+        int const key = local_token_selected_experts[i];
+        if (key < num_experts_per_node && shared_offsets[key] == 0) {
+          prune_mask |= 1u << i;
+          local_token_selected_experts[i] = num_experts_per_node;
+        }
+      }
+      __syncthreads();
+    } else {
+      for (int e = threadIdx.x; e < num_experts_per_node; e += BLOCK_SIZE) {
+        shared_offsets[e] = 0;
+      }
+      __syncthreads();
+#pragma unroll
+      for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+        if (local_token_selected_experts[i] < num_experts_per_node) {
+          atomicAdd(&shared_offsets[local_token_selected_experts[i]], 1);
+        }
+      }
+      __syncthreads();
+#pragma unroll
+      for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+        int const key = local_token_selected_experts[i];
+        if (key < num_experts_per_node) {
+          int rank = 0;
+#pragma unroll
+          for (int j = 0; j < EXPERTS_PER_TOKEN; j++) {
+            rank += (local_w[j] > local_w[i] || (local_w[j] == local_w[i] && j < i)) ? 1 : 0;
+          }
+          if (shared_offsets[key] == 1 && local_w[i] < prune_tau && rank >= prune_min_rank) {
+            prune_mask |= 1u << i;
+            local_token_selected_experts[i] = num_experts_per_node;
+          }
+        }
+      }
+    }
+    __syncthreads();
+    if (oea_stats != nullptr && blockIdx.x == 0) {
+      for (int e = threadIdx.x; e < num_experts_per_node; e += BLOCK_SIZE) shared_offsets[e] = 0;
+      __syncthreads();
+      float total = 0.f, kept_mass = 0.f;
+      int valid_count = 0, kept_count = 0;
+#pragma unroll
+      for (int i = 0; i < EXPERTS_PER_TOKEN; ++i) {
+        if (valid_mask & (1u << i)) {
+          int const expert = token_selected_experts[token * EXPERTS_PER_TOKEN + i] - start_expert;
+          bool const kept = !(prune_mask & (1u << i));
+          atomicOr(&shared_offsets[expert], kept ? 3 : 1);
+          ++valid_count;
+          total += local_w[i];
+          if (kept) { ++kept_count; kept_mass += local_w[i]; }
+        }
+      }
+      __syncthreads();
+      int before = 0, after = 0;
+      for (int e = threadIdx.x; e < num_experts_per_node; e += BLOCK_SIZE) {
+        before += shared_offsets[e] != 0;
+        after += (shared_offsets[e] & 2) != 0;
+      }
+      atomicAdd(oea_stats + 2, double(valid_count));
+      atomicAdd(oea_stats + 3, double(kept_count));
+      atomicAdd(oea_stats + 4, double(before));
+      atomicAdd(oea_stats + 5, double(after));
+      atomicAdd(oea_stats + 6, double(total > 0.f ? (total - kept_mass) / total : 0.f));
+      if (threadIdx.x == 0) {
+        atomicAdd(oea_stats, 1.0);
+        atomicAdd(oea_stats + 1, double(active_rows));  // oea-sd: live rows (== num_tokens without VT)
+        atomicAdd(oea_stats + 7, oea_applied ? 1.0 : 0.0);
+      }
+    }
+    __syncthreads();  // every histogram read precedes the shared_offsets writes below
+  }
+
+  int local_expert_first_token_offset[BlockRadixRank::BINS_TRACKED_PER_THREAD];
+  cub::BFEDigitExtractor<int> extractor(0, LOG2_NUM_EXPERTS);
+  BlockRadixRank(sort_temp).RankKeys(local_token_selected_experts, local_token_permuted_indices,
+                                     extractor, local_expert_first_token_offset);
+
+  bool const writer_block = (blockIdx.x == 0);
+  if (writer_block && is_valid_token) {
+#pragma unroll
+    for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+      int const unpermuted_row = i * num_tokens + token;
+      int const permuted_row = local_token_permuted_indices[i];
+      permuted_row_to_unpermuted_row[permuted_row] = unpermuted_row;
+      unpermuted_row_to_permuted_row[unpermuted_row] = permuted_row;
+    }
+    // P2: publish the dropped routes as id -1 / weight 0 (P1's convention) so the unfused
+    // finalize kernels skip them.  Other blocks of this grid re-read these tensors for their own
+    // copy of the rank; a block that observes the written state derives the same keys (a -1 id
+    // maps straight to the not-on-node bucket, and a zeroed weight only lowers the ranks of
+    // routes that were dropped anyway), so the order of these writes against those reads does
+    // not matter.
+    bool const is_tail = vt_lens != nullptr && !is_active_token;
+    if (is_tail || prune_mask != 0u) {
+#pragma unroll
+      for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+        if (is_tail || (prune_mask & (1u << i))) {
+          prune_ids_out[token * EXPERTS_PER_TOKEN + i] = -1;
+          prune_scales_out[token * EXPERTS_PER_TOKEN + i] = 0.f;
+        }
+      }
+    }
+  }
+
+#pragma unroll
+  for (int expert_id = 0; expert_id < BlockRadixRank::BINS_TRACKED_PER_THREAD; expert_id++) {
+    int out_expert_id = expert_id + token * BlockRadixRank::BINS_TRACKED_PER_THREAD;
+    if (out_expert_id < num_experts_per_node + 1) {
+      shared_offsets[out_expert_id] = local_expert_first_token_offset[expert_id];
+      if (writer_block) {
+        expert_first_token_offset[out_expert_id] = local_expert_first_token_offset[expert_id];
+      }
+    }
+  }
+
+  if constexpr (FUSE_EXPAND) {
+    // RankKeys gives BLOCK_SIZE * EXPERTS_PER_TOKEN distinct ranks, so these writes never collide
+    // (invalid tokens rank past num_valid_rows and are simply never read back).
+#pragma unroll
+    for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+      int const permuted_row = local_token_permuted_indices[i];
+      shared_inv_row[permuted_row] = i * static_cast<int>(num_tokens) + token;
+      shared_inv_expert[permuted_row] = local_token_selected_experts[i];
+    }
+  }
+  __syncthreads();
+
+  int const expert = blockIdx.x * BLOCK_SIZE + threadIdx.x;
+  // ---- G1: pack the active experts into the front of the group list ----------------------
+  // Confined to the descriptor blocks, which are exactly the blocks whose `expert` covers
+  // [0, num_experts_per_node) once -- the G2-2 row blocks are disjoint and untouched.  Every
+  // descriptor block already holds the whole `shared_offsets` array (the A3 design re-runs the
+  // rank in every block), so `rank(e)` and `D` need no grid-wide communication.
+  if (blockIdx.x < static_cast<unsigned>(stride_blocks)) {
+    int out_idx1 = expert;
+    int out_idx2 = expert;
+    if (g1.pack_groups) {
+      int const lane = threadIdx.x;  // BLOCK_SIZE == 32: one warp, all lanes live here
+      int const block_base = static_cast<int>(blockIdx.x) * BLOCK_SIZE;
+      int cnt_all = 0, cnt_before = 0;
+      for (int e = lane; e < num_experts_per_node; e += BLOCK_SIZE) {
+        int const a = (shared_offsets[e + 1] > shared_offsets[e]) ? 1 : 0;
+        cnt_all += a;
+        cnt_before += (e < block_base) ? a : 0;
+      }
+#pragma unroll
+      for (int off = BLOCK_SIZE / 2; off > 0; off >>= 1) {
+        cnt_all += __shfl_xor_sync(0xffffffff, cnt_all, off);
+        cnt_before += __shfl_xor_sync(0xffffffff, cnt_before, off);
+      }
+      int const d_active = cnt_all;
+      bool const is_active =
+          (expert < num_experts_per_node) && (shared_offsets[expert + 1] > shared_offsets[expert]);
+      unsigned const active_mask = __ballot_sync(0xffffffff, is_active ? 1 : 0);
+      int const rank = cnt_before + __popc(active_mask & ((1u << lane) - 1u));
+      out_idx1 = rank;
+      out_idx2 = rank;
+      // Thread `expert` owns leftover group index `expert`.  Ranks are all < d_active, so any
+      // slot >= d_active is unclaimed and is emptied here exactly once -- including by threads
+      // whose own expert is active but sits at a high index (they write their descriptor at
+      // `rank < d_active`, a different slot).
+      if (expert >= d_active) {
+        if (expert < g1.num_groups_gemm1) {
+          writeEmptyProblemShape(layout_info1, expert, gemm1_n, gemm1_k);
+        }
+        if (expert < g1.num_groups_gemm2) {
+          writeEmptyProblemShape(layout_info2, expert, gemm2_n, gemm2_k);
+        }
+      }
+      if (expert < num_experts_per_node && is_active) {
+        computeStridesTmaWarpSpecializedForExpert<T, WeightType, OutputType, ScaleBiasType>(
+            expert, shared_offsets[expert], shared_offsets[expert + 1], layout_info1, layout_info2,
+            gemm1_n, gemm1_k, gemm2_n, gemm2_k, gemm1_in, gemm2_in, weights1, weights2,
+            alpha_scale_flat1, alpha_scale_flat2, fp4_act_flat1, fp4_act_flat2, quant_params,
+            bias1, bias2, gemm1_output, gemm2_output, router_scales, permuted_row_to_unpermuted_row,
+            out_idx1, out_idx2);
+      }
+    } else if (expert < num_experts_per_node) {
+      computeStridesTmaWarpSpecializedForExpert<T, WeightType, OutputType, ScaleBiasType>(
+          expert, shared_offsets[expert], shared_offsets[expert + 1], layout_info1, layout_info2,
