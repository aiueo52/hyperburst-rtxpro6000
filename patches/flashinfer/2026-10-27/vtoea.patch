 #endif
 }
 
+// G2-1: FLASHINFER_MOE_FOLD_MEMSET=0 keeps the fused-finalize output zeroing as its own
+// cudaMemsetAsync launch instead of folding it into doActivationKernel's grid.
+inline bool foldMemsetEnabled() {
+  static bool const enabled = [] {
+    char const* v = std::getenv("FLASHINFER_MOE_FOLD_MEMSET");
+    return !(v && v[0] == '0' && v[1] == '\0');
+  }();
+  return enabled;
+}
+
+// G2-2: FLASHINFER_MOE_FOLD_EXPAND=0 keeps expandInputRowsKernel as its own launch.
+inline bool foldExpandEnabled() {
+  static bool const enabled = [] {
+    char const* v = std::getenv("FLASHINFER_MOE_FOLD_EXPAND");
+    return !(v && v[0] == '0' && v[1] == '\0');
+  }();
+  return enabled;
+}
+
+// P2: FLASHINFER_MOE_PRUNE_SINGLETON_TAU=<float> folds singleton-route pruning into the fused
+// routing prologue (see fusedBuildExpertMapsSortFirstTokenAndStridesKernel).  Unset / 0 = off,
+// upstream path byte-identical.  The three companions mirror SGLang's P1 knobs: MIN_RANK is the
+// lowest 0-based within-row rank eligible (>= 1, a row must keep its top-1), MIN_ROWS/MAX_ROWS
+// bound the batch sizes touched (default 2..64; the fused prologue itself stops at 32).
+struct MoePruneConfig {
+  float tau = 0.f;
+  int min_rank = 1;
+  int min_rows = 2;
+  int max_rows = 64;
+};
+inline MoePruneConfig const& moePruneConfig() {
+  static MoePruneConfig const cfg = [] {
+    MoePruneConfig c{};
+    if (char const* s = std::getenv("FLASHINFER_MOE_PRUNE_SINGLETON_TAU")) c.tau = std::atof(s);
+    if (char const* s = std::getenv("FLASHINFER_MOE_PRUNE_MIN_RANK")) c.min_rank = std::atoi(s);
+    if (char const* s = std::getenv("FLASHINFER_MOE_PRUNE_MIN_ROWS")) c.min_rows = std::atoi(s);
+    if (char const* s = std::getenv("FLASHINFER_MOE_PRUNE_MAX_ROWS")) c.max_rows = std::atoi(s);
+    if (!(c.tau > 0.f)) c.tau = 0.f;
+    if (c.min_rank < 1) c.min_rank = 1;
+    return c;
+  }();
+  return cfg;
+}
+
+// FLASHINFER_MOE_FUSED_STRIDES=0 keeps computeStridesTmaWarpSpecialized as its own launch.
+inline bool fusedStridesEnabled() {
+  static bool const enabled = [] {
+    char const* v = std::getenv("FLASHINFER_MOE_FUSED_STRIDES");
+    return !(v && v[0] == '0' && v[1] == '\0');
+  }();
+  return enabled;
+}
