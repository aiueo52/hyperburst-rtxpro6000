+template <class T, class WeightType, class OutputType, class ScaleBiasType, class InputAct,
+          int EXPERTS_PER_TOKEN, bool FUSE_EXPAND>
+bool launchFusedPrologueAndStrides(
+    FusedPrologueRequest& req, TmaWarpSpecializedGroupedGemmInput layout_info1,
+    TmaWarpSpecializedGroupedGemmInput layout_info2, int const num_experts_per_node,
+    int64_t gemm1_n, int64_t gemm1_k, int64_t gemm2_n, int64_t gemm2_k, T const* gemm1_in,
+    T const* gemm2_in, WeightType const* weights1, WeightType const* weights2,
+    float const* alpha_scale_flat1, float const* alpha_scale_flat2,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat1,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat2, QuantParams quant_params,
+    ScaleBiasType const* bias1, ScaleBiasType const* bias2, OutputType* gemm1_output,
+    OutputType* gemm2_output, float const* router_scales, bool enable_pdl, cudaStream_t stream) {
+  constexpr int BLOCK_SIZE = 32;
+  constexpr int LOG2_NUM_EXPERTS = 10;
+  using BlockRadixRank = FusedPrologueRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS>;
+
+  size_t const shared_size =
+      sizeof(typename BlockRadixRank::TempStorage) +
+      sizeof(int) * static_cast<size_t>(num_experts_per_node + 1) +
+      (FUSE_EXPAND ? 2 * sizeof(int) * size_t(BLOCK_SIZE) * size_t(EXPERTS_PER_TOKEN) : 0);
+
+  int device = 0;
+  int max_smem_per_block = 0;
+  check_cuda_error(cudaGetDevice(&device));
+  check_cuda_error(
+      cudaDeviceGetAttribute(&max_smem_per_block, cudaDevAttrMaxSharedMemoryPerBlockOptin, device));
+  if (shared_size >= static_cast<size_t>(max_smem_per_block)) {
+    return false;
+  }
+
+  auto kernel = &fusedBuildExpertMapsSortFirstTokenAndStridesKernel<
+      T, WeightType, OutputType, ScaleBiasType, InputAct, BLOCK_SIZE, EXPERTS_PER_TOKEN,
+      LOG2_NUM_EXPERTS, FUSE_EXPAND>;
+  check_cuda_error(
+      cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, shared_size));
+
+  int const stride_blocks = (num_experts_per_node + BLOCK_SIZE - 1) / BLOCK_SIZE;
+  int const row_blocks =
+      FUSE_EXPAND ? static_cast<int>(req.num_tokens * req.experts_per_token) : 0;
+
+  cudaLaunchConfig_t config;
+  config.gridDim = stride_blocks + row_blocks;
+  config.blockDim = BLOCK_SIZE;
+  config.dynamicSmemBytes = shared_size;
+  config.stream = stream;
+  cudaLaunchAttribute attrs[1];
+  attrs[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+  attrs[0].val.programmaticStreamSerializationAllowed = enable_pdl;
+  config.numAttrs = 1;
+  config.attrs = attrs;
+
+  check_cuda_error(cudaLaunchKernelEx(
+      &config, kernel, req.token_selected_experts, req.permuted_row_to_unpermuted_row,
+      req.unpermuted_row_to_permuted_row, req.expert_first_token_offset, req.num_tokens,
+      req.start_expert, req.end_expert, num_experts_per_node, layout_info1, layout_info2, gemm1_n,
+      gemm1_k, gemm2_n, gemm2_k, gemm1_in, gemm2_in, weights1, weights2, alpha_scale_flat1,
+      alpha_scale_flat2, fp4_act_flat1, fp4_act_flat2, quant_params, bias1, bias2, gemm1_output,
+      gemm2_output, router_scales, req.g1, stride_blocks,
+      reinterpret_cast<InputAct const*>(req.expand_input), reinterpret_cast<T*>(req.expand_output),
+      req.expand_unpermuted_scales, req.expand_permuted_scales, req.expand_act_sf_flat,
+      req.expand_act_global_scale, req.expand_use_per_expert_act_scale, req.expand_hidden_size,
+      req.prune_tau, req.prune_min_rank, req.prune_scales, req.prune_ids_out,
+      req.prune_scales_out, req.vt_lens, req.prune_min_rows, req.prune_max_rows,
+      req.vt_batch_size, req.oea_k0, req.oea_stats));
+  req.prune_fused = req.prune_tau > 0.f;
+  return true;
+}
+
+template <class T, class WeightType, class OutputType, class ScaleBiasType, class InputAct>
+bool tryFusedPrologueAndStrides(
+    FusedPrologueRequest& req, TmaWarpSpecializedGroupedGemmInput const& layout_info1,
+    TmaWarpSpecializedGroupedGemmInput const& layout_info2, int const num_experts_per_node,
+    int64_t gemm1_n, int64_t gemm1_k, int64_t gemm2_n, int64_t gemm2_k, T const* gemm1_in,
+    T const* gemm2_in, WeightType const* weights1, WeightType const* weights2,
+    float const* alpha_scale_flat1, float const* alpha_scale_flat2,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat1,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat2, QuantParams quant_params,
+    ScaleBiasType const* bias1, ScaleBiasType const* bias2, OutputType* gemm1_output,
+    OutputType* gemm2_output, float const* router_scales, bool enable_pdl, cudaStream_t stream) {
+  if (!fusedPrologueEnabled() || !fusedStridesEnabled()) {
+    return false;
+  }
+  if (req.num_tokens > 32 || num_experts_per_node + 1 >= 1024 ||
+      num_experts_per_node != (req.end_expert - req.start_expert)) {
+    return false;
+  }
+
+  // G2-2 gate.  Everything not covered here keeps the standalone expandInputRowsKernel launch.
+  constexpr int BLOCK_SIZE = 32;
+  bool fuse_expand = req.expand_requested && foldExpandEnabled();
+#ifdef ENABLE_FP4
+  if (fuse_expand) {
+    constexpr bool kTypesOk =
+        std::is_same_v<T, __nv_fp4_e2m1> &&
+        (std::is_same_v<InputAct, __nv_bfloat16> || std::is_same_v<InputAct, half>);
+    int64_t const elems_per_row = req.expand_hidden_size / CVT_ELTS_PER_THREAD;
+    fuse_expand =
+        kTypesOk && req.expand_input != nullptr && req.expand_output != nullptr &&
+        req.expand_act_sf_flat != nullptr && req.expand_hidden_size > 0 &&
+        req.expand_hidden_size % (CVT_ELTS_PER_THREAD * BLOCK_SIZE) == 0 &&
+        elems_per_row / BLOCK_SIZE <= G2_EXPAND_MAX_CHUNKS && req.num_tokens > 0 &&
+        req.experts_per_token > 0 &&
+        // the kernel hard-codes the default quantiser tags to keep one instantiation
+        !tensorrt_llm::common::getEnvNVFP4Use4Over6() &&
+        !tensorrt_llm::common::getEnvDisableFP4QuantFastMath();
+  }
+#else
+  fuse_expand = false;
+#endif
+  req.expand_fused = false;
+
+  auto go = [&](auto tag) {
+    if (fuse_expand) {
+      bool const ok = launchFusedPrologueAndStrides<T, WeightType, OutputType, ScaleBiasType,
+                                                    InputAct, decltype(tag)::value, true>(
+          req, layout_info1, layout_info2, num_experts_per_node, gemm1_n, gemm1_k, gemm2_n, gemm2_k,
+          gemm1_in, gemm2_in, weights1, weights2, alpha_scale_flat1, alpha_scale_flat2,
+          fp4_act_flat1, fp4_act_flat2, quant_params, bias1, bias2, gemm1_output, gemm2_output,
+          router_scales, enable_pdl, stream);
+      req.expand_fused = ok;
+      return ok;
+    }
+    return launchFusedPrologueAndStrides<T, WeightType, OutputType, ScaleBiasType, InputAct,
+                                         decltype(tag)::value, false>(
+        req, layout_info1, layout_info2, num_experts_per_node, gemm1_n, gemm1_k, gemm2_n, gemm2_k,
+        gemm1_in, gemm2_in, weights1, weights2, alpha_scale_flat1, alpha_scale_flat2, fp4_act_flat1,
+        fp4_act_flat2, quant_params, bias1, bias2, gemm1_output, gemm2_output, router_scales,
+        enable_pdl, stream);
+  };
+  switch (req.experts_per_token) {
+    case 1:
+      return go(std::integral_constant<int, 1>{});
+    case 2:
+      return go(std::integral_constant<int, 2>{});
+    case 4:
+      return go(std::integral_constant<int, 4>{});
+    case 6:
+      return go(std::integral_constant<int, 6>{});
+    case 8:
+      return go(std::integral_constant<int, 8>{});
+    case 10:
+      return go(std::integral_constant<int, 10>{});
+    default:
+      return false;
+  }
+}
