+            reinterpret_cast<DataElem const*>(expand_input + source_row * expand_hidden_size);
+        auto* dest_row_ptr = reinterpret_cast<OutputElem*>(expand_output) +
+                             permuted_row * num_elems_in_col;
+
+        // RQ2: stage the whole row in shared memory with cp.async. With one warp per row the loads
+        // must all be in flight at once, or the 10 dependent round trips cost more than the launch
+        // we deleted; cp.async does that without holding registers, so the quantize loop below can
+        // stay compact. Unrolled, that loop is ~20 KB of straight-line SASS whose instruction lines
+        // miss L2 after weight streaming (+3.8 us per call, FC_fc-moe 4b.1c).
+        __shared__ __align__(16) uint4 g2_stage[G2_EXPAND_MAX_CHUNKS * BLOCK_SIZE];
+        auto const* source_row_u4 = reinterpret_cast<uint4 const*>(source_row_ptr);
+#pragma unroll
+        for (int chunk = 0; chunk < G2_EXPAND_MAX_CHUNKS; chunk++) {
+          if (chunk < trips) {
