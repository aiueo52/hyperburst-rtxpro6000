+        // chunk carries a divergent branch the next chunk cannot be scheduled across. In the
+        // SWIZZLED_128x4 layout a chunk (32 lanes x 8 elements = 16 SF vectors) covers exactly 4
+        // K tiles of [32][4][4] = 512 bytes, so the byte moves by a constant per chunk and only
+        // the first one needs the full formula (same result as cvt_quant_get_sf_out_offset).
+        constexpr int SF_LANES = VecSize / ELEM_PER_THREAD;    // lanes per SF byte (2)
+        constexpr int SF_PER_CHUNK = BLOCK_SIZE / SF_LANES;   // 16
+        static_assert(VecSize % ELEM_PER_THREAD == 0 && SF_PER_CHUNK % 4 == 0,
+                      "a chunk must cover whole 128x4 K tiles");
+        constexpr int64_t SF_CHUNK_STRIDE = SF_PER_CHUNK / 4 * 512;  // 2048
+        uint8_t* const sf_row =
+            threadIdx.x % SF_LANES == 0
+                ? reinterpret_cast<uint8_t*>(
+                      expand_act_sf_flat +
+                      getOffsetActivationSF(
+                          row_expert, num_tokens_before_expert, padded_hidden_size,
+                          TmaWarpSpecializedGroupedGemmInput::FpXBlockScalingType::NVFP4)) +
+                      static_cast<uint32_t>(get_sf_out_offset_128x4(
+                          static_cast<int>(permuted_row - num_tokens_before_expert),
+                          static_cast<int>(threadIdx.x) / SF_LANES,
+                          static_cast<int>(padded_hidden_size / VecSize)))
+                : nullptr;
+#endif
+#pragma unroll 1
+        for (int chunk0 = 0; chunk0 < trips; chunk0 += G2_EXPAND_QUANT_UNROLL) {
+#pragma unroll
+          for (int u = 0; u < G2_EXPAND_QUANT_UNROLL; u++) {
+            // An odd tail repeats the last chunk (the same bytes to the same places) instead of
+            // branching around the second body, so the bodies can interleave.
+            int const chunk = min(chunk0 + u, trips - 1);
+            int64_t const elem_index = threadIdx.x + chunk * BLOCK_SIZE;
+            DataElem staged;
+            *reinterpret_cast<uint4*>(&staged) = g2_stage[elem_index];
+#if G2_EXPAND_SF_HOIST
+            // quantizePackedFPXValue's NVFP4 path with the SF address from sf_row.
+            PackedVec<InputAct> packed_vec{};
+            for (int i = 0; i < CVT_ELTS_PER_THREAD / 2; i++) {
+              packed_vec.elts[i].x = static_cast<InputAct>(staged[i * 2 + 0]);
+              packed_vec.elts[i].y = static_cast<InputAct>(staged[i * 2 + 1]);
+            }
+            auto res = cvt_warp_fp16_to_fp4<InputAct, VecSize, CVT_ELTS_PER_THREAD, false, false,
+                                            std::false_type>(
+                packed_vec, global_scale_val,
+                sf_row ? sf_row + SF_CHUNK_STRIDE * chunk : nullptr, 0.0f);
+#else
+            auto res = quantizePackedFPXValue<InputAct, T, DataElem, VecSize, false,
+                                              std::false_type>(
+                staged, global_scale_val, num_tokens_before_expert, row_expert, permuted_row,
+                elem_index, padded_hidden_size, expand_act_sf_flat,
+                TmaWarpSpecializedGroupedGemmInput::FpXBlockScalingType::NVFP4);
+#endif
+            static_assert(sizeof(res) == sizeof(*dest_row_ptr),
+                          "Quantized value must be the same size as the output");
+            dest_row_ptr[elem_index] = res;
+          }
+        }
+
+        // K-dim SF padding, exactly as expandInputRowsKernel does it (a no-op when
+        // hidden_size % 64 == 0).
+        for (int64_t elem_index = expand_hidden_size / VecSize + threadIdx.x;
+             elem_index < padded_hidden_size / VecSize; elem_index += BLOCK_SIZE) {
+          writeSF<VecSize, VecSize>(num_tokens_before_expert, row_expert, /*source_row*/ -1,
+                                    permuted_row, elem_index, padded_hidden_size,
+                                    expand_act_sf_flat, /*input_sf*/ nullptr);
+        }
