+// CTA tile M of an sm120 grouped-GEMM tactic.  Every sm120 FP4 tile is 128 or 256 rows
+// (`cutlass_heuristic.cpp: get_candidate_configs_sm120`); anything else disables packing.
+inline int g1CtaTileM(cutlass_extensions::CutlassGemmConfig const& cfg) {
+  if (!cfg.is_tma_warp_specialized) return 0;
+  switch (cfg.tile_config_sm120) {
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape128x128x128B:
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape128x128x64B:
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape128x256x64B:
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape128x128x256B:
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape128x32x128B:
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape128x32x64B:
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape128x64x128B:
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape128x64x64B:
+      return 128;
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape256x128x64B:
+    case cutlass_extensions::CutlassTileConfigSM120::CtaShape256x128x128B:
+      return 256;
+    default:
+      return 0;
+  }
+}
