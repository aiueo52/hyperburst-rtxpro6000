+// ======================= G1: active-group packing =======================
+//
+// Write the D active experts into CUTLASS groups [0, D) instead of leaving them scattered over
+// all `num_experts_per_node` slots, and shorten the group list to the host-side bound
+// `expanded_num_rows` (an active expert owns at least one permuted row).  Nothing in CUTLASS
+// changes: the sm120 array kernel re-derives every TMA descriptor from the per-group
+// `dA/dB/layout_SFA/layout_SFB` + problem shape, and every per-group array the epilogue reads
+// (alpha scales, and FINALIZE's source-token / router-scale / bias pointers) is indexed by the
+// group index `l`, so a permuted group order is an ordinary input.
+//
+// The win is the persistent tile scheduler's linear group scan
+// (`sm90_tile_scheduler_group.hpp: get_work_idx_m_and_n` reads 32 problem shapes per iteration
+// of dependent global loads); at E=512 with D~28 it walks ~13x more of the list than it needs.
+inline int moePackGroupsEnabled() {
+  static int const v = [] {
+    char const* s = std::getenv("FLASHINFER_MOE_PACK_GROUPS");
+    return (s && s[0] != '0') ? 1 : 0;
+  }();
+  return v;
+}
+
+// How much the group list must shorten (`expanded_num_rows * ratio <= num_experts_per_node`)
+// before packing is allowed.  On the A0+A3 base this had to default to 4: the rank computation
+// added ~0.6 us to a short, latency-bound prologue, which the 3.2x shortening at W16 did not
+// cover.  On top of G2-2 the prologue also carries `num_tokens * k` row blocks, so the rank
+// hides inside it entirely (measured: prologue -0.12 us at W4, -0.08 us at W16) and packing
+// wins at both widths -- hence the default of 1.  Raise it to re-enable the old gate.
+inline int moePackMinRatio() {
+  static int const v = [] {
+    char const* s = std::getenv("FLASHINFER_MOE_PACK_MIN_RATIO");
+    int n = s ? std::atoi(s) : 1;
+    return n < 1 ? 1 : n;
+  }();
+  return v;
+}
