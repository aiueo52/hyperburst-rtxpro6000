+// ====== H40 S2: prologue changes.  Every output of the kernel below is bit-identical to what the code it replaces wrote
+// (patches/flashinfer/2026-11-08/README.md describes each change and the checks).  Summary:
+//  1(a) VT row arithmetic in 32 bits with rows_per_request from the host; (slot, token) packed in shared_inv_row;
+//  1(b) P2 prune in O(k) for min_rank == 1;   1(c) vt_lens read before the grid-dependency wait, ids and weights loaded together;
+//  2(a) one __match_any_sync per item instead of ten ballots;   2(b) striped publish of the offsets (no 32-way bank conflicts,
+//  coalesced global stores of expert_first_token_offset);   __syncwarp instead of __syncthreads (the block is one warp).
+
+// 1(a): min(max(len, 0) + 1, rows_per_request) without the overflow of `len + 1` at INT32_MAX.
+__device__ __forceinline__ int moeVtRequestRows32(int len, int rows_per_request) {
+  int const l = len > 0 ? len : 0;
+  return l < rows_per_request ? l + 1 : rows_per_request;
+}
+
+// 2: a one-warp copy of cub::BlockRadixRankMatch<32, 10, false>::RankKeys(keys, ranks, extractor, exclusive_prefix): the same
+// algorithm and the same numbers (ranks in (key, item, lane) order; the exclusive digit prefix), with
+//  (a) the 10-bit software match (ten ballots and their AND per item: 100 VOTEs in the kernel) replaced by one __match_any_sync,
+//  (b) no per-lane exclusive_digit_prefix[32]: the prefix stays in the counter words, and the caller reads it striped (lane l
+//      reads digit 32*r + l: conflict free) instead of blocked (lane l reads digit 32*l + r: all 32 lanes in one bank),
+//  (c) __syncwarp instead of __syncthreads (the block is one warp) and no BlockScan (its barrier and temp storage).
+template <int EXPERTS_PER_TOKEN>
+struct FusedPrologueWarpRank {
+  static constexpr int WARP = 32;
+  static constexpr int DIGITS = 1 << 10;
+  static constexpr int SEGMENT = 33;  // raking segment of cub: 32 words per lane + 1 pad word, conflict free
+  static_assert(SEGMENT * WARP >= DIGITS, "the counters must cover all digits");
+  struct alignas(16) TempStorage {
+    int words[SEGMENT * WARP];
+  };
+
+  // keys[i] in [0, DIGITS).  ranks[i] = the position of the key in the (key, item, lane) order.  On return words[d] is the number
+  // of keys whose digit is below d (d in [0, DIGITS)), visible to the whole warp.
+  __device__ __forceinline__ static void rank(TempStorage& ts, int const (&keys)[EXPERTS_PER_TOKEN],
+                                              int (&ranks)[EXPERTS_PER_TOKEN]) {
+    volatile int* const counters = ts.words;
+    int const lane = static_cast<int>(threadIdx.x);
+    unsigned const lane_mask_lt = (1u << lane) - 1u;
+
+#pragma unroll
+    for (int j = 0; j < SEGMENT; j++) {
+      counters[lane * SEGMENT + j] = 0;
+    }
+    __syncwarp();
+
+    // each item is one strip of 32 keys (lane order); the counters hold the per-digit totals of the earlier strips
+#pragma unroll
+    for (int item = 0; item < EXPERTS_PER_TOKEN; item++) {
+      unsigned const digit = static_cast<unsigned>(keys[item]) & (DIGITS - 1);
+      unsigned const peer_mask = __match_any_sync(0xffffffffu, digit);
+      int const prefix = counters[digit];
+      __syncwarp();
+      int const count = __popc(peer_mask);
+      int const peer_prefix = __popc(peer_mask & lane_mask_lt);
+      if (peer_prefix == 0) {
+        counters[digit] = prefix + count;  // the first lane of each group of equal digits
+      }
+      __syncwarp();
+      ranks[item] = prefix + peer_prefix;
+    }
+    __syncwarp();
+
+    // exclusive prefix over the 33 * 32 words in flat order (flat index == digit): each lane sums its 33 words, the 32 sums are
+    // scanned across the warp, then each lane writes its running sum back
+    int seg[SEGMENT];
+    int sum = 0;
+#pragma unroll
+    for (int j = 0; j < SEGMENT; j++) {
+      seg[j] = counters[lane * SEGMENT + j];
+      sum += seg[j];
+    }
+    int inclusive = sum;
+#pragma unroll
+    for (int offset = 1; offset < WARP; offset <<= 1) {
+      int const other = __shfl_up_sync(0xffffffffu, inclusive, offset);
+      if (lane >= offset) inclusive += other;
+    }
+    int running = inclusive - sum;
+#pragma unroll
+    for (int j = 0; j < SEGMENT; j++) {
+      counters[lane * SEGMENT + j] = running;
+      running += seg[j];
+    }
+    __syncwarp();
+
+#pragma unroll
+    for (int item = 0; item < EXPERTS_PER_TOKEN; item++) {
+      ranks[item] += counters[static_cast<unsigned>(keys[item]) & (DIGITS - 1)];
+    }
+  }
+};
