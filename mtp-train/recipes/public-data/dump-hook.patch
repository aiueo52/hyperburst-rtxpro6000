+"""Env-gated extraction of MTP training data from the Qwen4Exp target model.
+
+Enabled only when ``SGLANG_MTP_DUMP_DIR`` is set.  When it is, every *extend*
+(prefill) forward of the TARGET model writes one safetensors file containing,
+per token:
+
+    input_ids      int32 [T]        the tokens of this forward
+    positions      int32 [T]        absolute target positions
+    hc_hidden      bf16  [T, 4*H]   residual after the last layer and BEFORE
+                                    ``hyper_connection_mixer`` -- exactly the
+                                    tensor the draft head consumes
+    target_argmax  int32 [T]        argmax of the target logits at every
+                                    position (the server only computes
+                                    last-token logits, so this is recomputed
+                                    here chunk-wise from the mixed 2560-wide
+                                    hidden through the target lm_head)
+    seq_offsets    int32 [S+1]      per-request slice boundaries
+    prefix_lens    int32 [S]        radix-cache prefix length per request
+    topk_ids       int32 [T, K]     optional (SGLANG_MTP_DUMP_TOPK=K)
+    topk_logits    fp16  [T, K]     optional
+    lse            fp16  [T]        optional, written with the top-K: the
+                                    logsumexp of the FULL-vocabulary target
+                                    logits, so a consumer can recover the
+                                    probability mass outside the top-K as
+                                    ``1 - exp(logsumexp(topk_logits) - lse)``
+    tap_hidden     bf16  [T, N*4*H] optional (SGLANG_MTP_DUMP_TAPS=3,23): the
+                                    *output* HC state of each tapped decoder
+                                    layer, concatenated in the order the env
+                                    var lists them.  Each tap is exactly the
+                                    same kind of tensor as ``hc_hidden`` (the
+                                    residual stream between two layers, before
+                                    any mixer), which is what an EAGLE-3-style
+                                    multi-layer entry would consume.  The tap
+                                    layer ids are repeated in the file metadata
+                                    as ``tap_layers`` so training and serving
+                                    can never silently disagree.
+
+Design constraints:
+  * Decode / target-verify / draft forwards are never touched, so the CUDA
+    graph replay path is untouched (prefill runs eager).
+  * Nothing is imported or allocated when the env var is unset.
+  * Writing happens on a background thread with a bounded queue so a slow disk
+    back-pressures the server instead of buffering unboundedly.
+
+Environment:
+    SGLANG_MTP_DUMP_DIR     output directory (enables everything)
+    SGLANG_MTP_DUMP_TOPK    also store top-K ids/logits per row (default 0)
+    SGLANG_MTP_DUMP_CHUNK   rows per lm_head matmul chunk (default 1024)
+    SGLANG_MTP_DUMP_MAX_GB  stop dumping after this many GB (default 400)
+    SGLANG_MTP_DUMP_TAG     filename prefix (default "dump")
+    SGLANG_MTP_DUMP_TAPS    comma-separated decoder layer ids whose output HC
+                            state is also stored (default "": no taps)
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import queue
+import threading
+import time
+from typing import Optional
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_DUMPER: Optional["MTPDumper"] = None
+_INIT_DONE = False
+
+
+def dump_enabled() -> bool:
+    return get_dumper() is not None
+
+
+def get_dumper() -> Optional["MTPDumper"]:
+    global _DUMPER, _INIT_DONE
+    if not _INIT_DONE:
+        _INIT_DONE = True
+        directory = os.environ.get("SGLANG_MTP_DUMP_DIR", "").strip()
+        if directory:
+            _DUMPER = MTPDumper(directory)
+            logger.warning("MTP dump ENABLED -> %s", directory)
+    return _DUMPER
+
+
+_TAPS: Optional[tuple] = None
+
+
+def tap_layer_ids() -> tuple:
+    """Decoder layers whose output HC state the dump also stores.
+
+    Read once from ``SGLANG_MTP_DUMP_TAPS``.  Empty (the default) means the
+    capture is completely absent from the forward pass, so a server started
+    without it is byte-for-byte the ordinary one.
+    """
+    global _TAPS
+    if _TAPS is None:
+        raw = os.environ.get("SGLANG_MTP_DUMP_TAPS", "").strip()
+        _TAPS = tuple(int(x) for x in raw.replace(" ", "").split(",") if x)
+        if _TAPS:
+            logger.warning("MTP dump: capturing tap layers %s", list(_TAPS))
+    return _TAPS
+
+
+def project_lm_head(lm_head, x: "torch.Tensor") -> "torch.Tensor":
+    """Apply the (possibly quantized) lm_head exactly as the server does.
+
+    Under `--qwen4-exp-dense-fp8 ...,lm_head` the head is W8A16 FP8 and a plain
+    F.linear cannot be used, so route through the same quant method that
+    LogitsProcessor._compute_lm_head picks.
+    """
+    quant_method = getattr(lm_head, "quant_method", None)
+    if quant_method is not None:
+        try:
+            from sglang.srt.layers.logits_processor import (
+                should_apply_lm_head_quant_method,
+            )
+
+            if should_apply_lm_head_quant_method(lm_head, quant_method):
+                return quant_method.apply(lm_head, x, None)
+        except ImportError:
+            pass
+    weight = lm_head.weight
+    return torch.nn.functional.linear(x.to(weight.dtype), weight)
+
+
+class MTPDumper:
+    def __init__(self, directory: str):
+        self.dir = directory
+        os.makedirs(self.dir, exist_ok=True)
+        self.topk = int(os.environ.get("SGLANG_MTP_DUMP_TOPK", "0"))
+        self.chunk = int(os.environ.get("SGLANG_MTP_DUMP_CHUNK", "1024"))
+        self.max_bytes = float(os.environ.get("SGLANG_MTP_DUMP_MAX_GB", "400")) * 2**30
+        self.tag = os.environ.get("SGLANG_MTP_DUMP_TAG", "dump")
+        self.counter = 0
+        self.bytes_written = 0
+        self.rows_written = 0
+        self.stopped = False
+        self._staged = None
+        self._queue: "queue.Queue" = queue.Queue(maxsize=4)
+        self._thread = threading.Thread(target=self._writer, daemon=True)
+        self._thread.start()
+
+    # ------------------------------------------------------------- writer
+    def _writer(self) -> None:
+        from safetensors.torch import save_file
+
+        while True:
+            item = self._queue.get()
+            if item is None:
+                self._queue.task_done()
+                return
+            path, tensors, meta = item
+            try:
+                tmp = path + ".tmp"
+                save_file(tensors, tmp, metadata=meta)
+                os.replace(tmp, path)
+                self.bytes_written += os.path.getsize(path)
+            except Exception:  # noqa: BLE001
+                logger.exception("MTP dump write failed for %s", path)
+            finally:
+                self._queue.task_done()
+
+    def close(self) -> None:
+        self._queue.put(None)
+        self._thread.join(timeout=60)
+
+    # -------------------------------------------------------------- stage
+    def stage(
+        self, input_ids, positions, forward_batch, mixed_hidden, hc_hidden, taps=None
+    ) -> None:
+        """Called from the language model with everything except lm_head."""
+        self._staged = None
+        if self.stopped or hc_hidden is None or mixed_hidden is None:
+            return
+        if isinstance(mixed_hidden, tuple):  # fused all-reduce payload
+            mixed_hidden = mixed_hidden[0]
+        mode = forward_batch.forward_mode
+        if not mode.is_extend_or_draft_extend_or_mixed():
+            return
+        if mode.is_target_verify() or mode.is_idle():
+            return
+        try:
+            from sglang.srt.model_executor.runner import get_is_capture_mode
+
+            if get_is_capture_mode():
+                return
+        except Exception:  # noqa: BLE001
+            pass
+        if input_ids is None:
+            input_ids = forward_batch.input_ids
+        n = int(input_ids.shape[0])
+        if n < 4 or hc_hidden.shape[0] != n or mixed_hidden.shape[0] != n:
+            return
+        wanted = len(tap_layer_ids())
+        if wanted:
+            # A short/None tap list means the capture did not run for this
+            # forward (idle rank, graph capture, a shape guard upstream).
+            # Writing a row without its taps would silently produce a file the
+            # trainer reads as "no taps", so drop the batch instead.
+            if not taps or len(taps) != wanted or any(
+                t is None or t.shape[0] != n for t in taps
+            ):
+                return
+        self._staged = (
+            input_ids, positions, forward_batch, mixed_hidden, hc_hidden, taps
+        )
+
+    # -------------------------------------------------------------- flush
+    @torch.no_grad()
+    def flush(self, lm_head) -> None:
+        staged, self._staged = self._staged, None
+        if staged is None or self.stopped:
+            return
+        if self.bytes_written >= self.max_bytes:
+            if not self.stopped:
+                logger.warning(
+                    "MTP dump budget reached (%.1f GB); stopping",
+                    self.bytes_written / 2**30,
+                )
+                self.stopped = True
+            return
+        input_ids, positions, forward_batch, mixed, hc_hidden, taps = staged
+        n = int(input_ids.shape[0])
+        argmax = torch.empty(n, dtype=torch.int32, device=mixed.device)
+        topk_ids = topk_vals = None
+        lse = None
+        if self.topk > 0:
+            topk_ids = torch.empty(n, self.topk, dtype=torch.int32, device=mixed.device)
+            topk_vals = torch.empty(
+                n, self.topk, dtype=torch.float16, device=mixed.device
+            )
+            lse = torch.empty(n, dtype=torch.float16, device=mixed.device)
+        try:
+            for start in range(0, n, self.chunk):
+                end = min(n, start + self.chunk)
+                logits = project_lm_head(lm_head, mixed[start:end])
+                argmax[start:end] = logits.argmax(dim=-1).to(torch.int32)
+                if self.topk > 0:
+                    logits32 = logits.float()
+                    vals, ids = torch.topk(logits32, self.topk, dim=-1)
+                    topk_ids[start:end] = ids.to(torch.int32)
+                    topk_vals[start:end] = vals.to(torch.float16)
+                    # Full-vocabulary logsumexp, so the mass outside the top-K
+                    # is recoverable: p(top-K) = exp(logsumexp(topk) - lse).
+                    lse[start:end] = torch.logsumexp(logits32, dim=-1).to(
+                        torch.float16
+                    )
+                    del logits32
+                del logits
+        except Exception as exc:  # noqa: BLE001
+            # target_argmax is the training label: a dump without it is useless,
+            # so stop dumping loudly rather than write unlabelled files.
+            logger.error(
+                "MTP dump: target lm_head projection failed (%s); DISABLING dump",
+                exc,
+            )
+            self.stopped = True
+            return
+
+        seq_lens = forward_batch.extend_seq_lens_cpu
+        if seq_lens is None and forward_batch.extend_seq_lens is not None:
+            seq_lens = forward_batch.extend_seq_lens.tolist()
+        if not seq_lens:
+            seq_lens = [n]
+        offsets = [0]
+        for length in seq_lens:
+            offsets.append(offsets[-1] + int(length))
+        if offsets[-1] != n:  # chunked prefill bookkeeping mismatch: treat as one
+            offsets = [0, n]
+            seq_lens = [n]
+        prefix = forward_batch.extend_prefix_lens_cpu
+        if prefix is None and forward_batch.extend_prefix_lens is not None:
+            prefix = forward_batch.extend_prefix_lens.tolist()
+        if not prefix or len(prefix) != len(seq_lens):
+            prefix = [0] * len(seq_lens)
+
+        tensors = {
+            "input_ids": input_ids.to(torch.int32).cpu(),
+            "positions": positions.reshape(-1)[:n].to(torch.int32).cpu()
+            if positions is not None
+            else torch.arange(n, dtype=torch.int32),
+            "hc_hidden": hc_hidden.to(torch.bfloat16).cpu(),
+            "target_argmax": argmax.cpu(),
+            "seq_offsets": torch.tensor(offsets, dtype=torch.int32),
+            "prefix_lens": torch.tensor(prefix, dtype=torch.int32),
+        }
+        if self.topk > 0:
+            tensors["topk_ids"] = topk_ids.cpu()
+            tensors["topk_logits"] = topk_vals.cpu()
+            tensors["lse"] = lse.cpu()
+        if taps:
+            tensors["tap_hidden"] = (
+                torch.cat([t.to(torch.bfloat16) for t in taps], dim=-1).cpu()
+            )
+
+        self.counter += 1
+        self.rows_written += n
+        name = f"{self.tag}-{os.getpid()}-{self.counter:08d}.safetensors"
+        meta = {
+            "forward_mode": str(forward_batch.forward_mode),
+            "tokens": str(n),
+            "sequences": str(len(seq_lens)),
+            "written_at": f"{time.time():.3f}",
+            "tap_layers": ",".join(str(i) for i in tap_layer_ids()),
+        }
+        try:
+            self._queue.put((os.path.join(self.dir, name), tensors, meta), timeout=300)
+        except queue.Full:  # pragma: no cover
+            logger.error("MTP dump queue full for 300 s; dropping a batch")
+
+    def stats(self) -> dict:
+        return {
+            "files": self.counter,
+            "rows": self.rows_written,
+            "gb": round(self.bytes_written / 2**30, 3),
+            "stopped": self.stopped,
+        }
+
+
+def maybe_stage(
+    model, input_ids, positions, forward_batch, mixed, hc_hidden, taps=None
+) -> None:
+    dumper = get_dumper()
+    if dumper is not None:
+        dumper.stage(input_ids, positions, forward_batch, mixed, hc_hidden, taps)
+
+
+def maybe_flush(lm_head) -> None:
+    dumper = get_dumper()
+    if dumper is not None:
+        dumper.flush(lm_head)
+
+
+# ---------------------------------------------------------------------------
+# Draft-side dump (parity gate only -- SGLANG_MTP_DRAFT_DUMP_DIR)
+# ---------------------------------------------------------------------------
+_DRAFT: Optional["MTPDraftDumper"] = None
+_DRAFT_INIT = False
+
+
+def get_draft_dumper() -> Optional["MTPDraftDumper"]:
+    global _DRAFT, _DRAFT_INIT
+    if not _DRAFT_INIT:
+        _DRAFT_INIT = True
+        directory = os.environ.get("SGLANG_MTP_DRAFT_DUMP_DIR", "").strip()
+        if directory:
+            _DRAFT = MTPDraftDumper(directory)
+            logger.warning("MTP DRAFT dump ENABLED -> %s", directory)
+    return _DRAFT
+
+
+class MTPDraftDumper:
+    """Records the draft head's own inputs and outputs during draft-extend.
+
+    This exists purely so the standalone trainer can be proved numerically
+    identical to the served head: it stores the exact tensors the draft
+    consumed (its shifted input ids, its positions, and the target HC state it
+    was handed) next to what it produced (pre-mixer HC state, mixed state,
+    argmax and top-K logits).  Nothing here is needed for training.
+
+    Only draft-*extend* forwards are recorded; draft decode runs inside a CUDA
+    graph and is skipped, as is capture mode.
+    """
+
+    def __init__(self, directory: str):
+        self.dir = directory
+        os.makedirs(self.dir, exist_ok=True)
+        self.topk = int(os.environ.get("SGLANG_MTP_DRAFT_DUMP_TOPK", "8"))
+        self.chunk = int(os.environ.get("SGLANG_MTP_DRAFT_DUMP_CHUNK", "1024"))
+        self.max_bytes = (
+            float(os.environ.get("SGLANG_MTP_DRAFT_DUMP_MAX_GB", "40")) * 2**30
+        )
+        self.tag = os.environ.get("SGLANG_MTP_DRAFT_DUMP_TAG", "draft")
+        self.counter = 0
+        self.bytes_written = 0
+        self.rows_written = 0
+        self.stopped = False
+        self._queue: "queue.Queue" = queue.Queue(maxsize=4)
+        self._thread = threading.Thread(target=self._writer, daemon=True)
+        self._thread.start()
+
+    _writer = MTPDumper._writer
+    close = MTPDumper.close
+
+    @torch.no_grad()
+    def dump(
+        self,
+        model,
+        input_ids,
+        positions,
+        forward_batch,
+        input_hc,
+        mixed,
+        own_hc,
+    ) -> None:
+        if self.stopped or input_hc is None or own_hc is None or mixed is None:
+            return
+        if self.bytes_written >= self.max_bytes:
+            if not self.stopped:
+                logger.warning("MTP draft dump budget reached; stopping")
+                self.stopped = True
+            return
+        mode = forward_batch.forward_mode
+        if not mode.is_extend_or_draft_extend_or_mixed():
+            return
+        if mode.is_target_verify() or mode.is_idle():
+            return
+        try:
+            from sglang.srt.model_executor.runner import get_is_capture_mode
+
+            if get_is_capture_mode():
+                return
+        except Exception:  # noqa: BLE001
+            pass
+        if isinstance(mixed, tuple):
+            mixed = mixed[0]
+        n = int(input_ids.shape[0])
+        if n < 4 or own_hc.shape[0] != n or input_hc.shape[0] != n:
+            return
+
+        weight = getattr(model.lm_head, "weight", None)
+        if weight is None or weight.dim() != 2:
+            logger.error("MTP draft dump: unusable lm_head; disabling")
+            self.stopped = True
+            return
+
+        argmax = torch.empty(n, dtype=torch.int32, device=mixed.device)
+        topk_ids = torch.empty(n, self.topk, dtype=torch.int32, device=mixed.device)
+        topk_vals = torch.empty(n, self.topk, dtype=torch.float32, device=mixed.device)
+        logits_ok = True
+        try:
+            for start in range(0, n, self.chunk):
+                end = min(n, start + self.chunk)
+                logits = project_lm_head(lm_head, mixed[start:end]).float()
+                argmax[start:end] = logits.argmax(dim=-1).to(torch.int32)
+                vals, ids = torch.topk(logits, self.topk, dim=-1)
+                topk_ids[start:end] = ids.to(torch.int32)
+                topk_vals[start:end] = vals
+                del logits
+        except Exception as exc:  # noqa: BLE001
+            # A quantized lm_head (e.g. --qwen4-exp-dense-fp8 ...,mtp_dense)
+            # cannot be applied with a plain F.linear.  The hidden states are
+            # what the comparison needs; drop the logits rather than crash.
+            logits_ok = False
+            logger.warning("MTP draft dump: skipping logits (%s)", exc)
+
+        seq_lens = forward_batch.extend_seq_lens_cpu
+        if seq_lens is None and forward_batch.extend_seq_lens is not None:
+            seq_lens = forward_batch.extend_seq_lens.tolist()
+        if not seq_lens:
+            seq_lens = [n]
+        offsets = [0]
+        for length in seq_lens:
+            offsets.append(offsets[-1] + int(length))
+        if offsets[-1] != n:
+            offsets = [0, n]
+
+        post_attn = take_post_attn_hc()
+        tensors = {
+            "input_ids": input_ids.to(torch.int32).cpu(),
+            "positions": positions.reshape(-1)[:n].to(torch.int32).cpu(),
+            "input_hc": input_hc.to(torch.bfloat16).cpu(),
+            "own_hc": own_hc.to(torch.bfloat16).cpu(),
+            "mixed": mixed.to(torch.bfloat16).cpu(),
+            "seq_offsets": torch.tensor(offsets, dtype=torch.int32),
+        }
+        if logits_ok:
+            tensors["argmax"] = argmax.cpu()
+            tensors["topk_ids"] = topk_ids.cpu()
+            tensors["topk_logits"] = topk_vals.cpu()
+        if post_attn is not None and post_attn.shape[0] == n:
+            tensors["post_attn_hc"] = post_attn.to(torch.bfloat16).cpu()
+        self.counter += 1
+        self.rows_written += n
+        name = f"{self.tag}-{os.getpid()}-{self.counter:08d}.safetensors"
+        meta = {
+            "forward_mode": str(forward_batch.forward_mode),
+            "tokens": str(n),
+            # A reduced draft vocabulary (--speculative-token-map) makes argmax /
+            # topk_ids indices into the hot-token list, not the real vocabulary.
+            "lm_head_vocab": str(int(weight.shape[0])),
+            "lm_head_dtype": str(weight.dtype),
+            "has_logits": "1" if logits_ok else "0",
+        }
+        try:
+            self._queue.put((os.path.join(self.dir, name), tensors, meta), timeout=300)
+        except queue.Full:  # pragma: no cover
+            logger.error("MTP draft dump queue full; dropping a batch")
+
+
+# The draft's MoE experts are quantized to NVFP4 online in every supported
+# configuration (--speculative-draft-model-quantization unquant still resolves
+# to the target's modelopt_fp4 config).  To separate a structural bug in the
+# reimplementation from that quantization error, also record the HC state at
+# the attention/MLP boundary: everything up to there -- input fusion, both
+# norms, the hyper-connection mix/combine, QSA attention with its output gate
+# and partial RoPE -- runs in BF16 and must match exactly.
+_POST_ATTN_HC = None
+_POST_ATTN_ENABLED = None
+
+
+def stash_post_attn_hc(hidden_states) -> None:
+    global _POST_ATTN_HC, _POST_ATTN_ENABLED
+    if _POST_ATTN_ENABLED is None:
+        _POST_ATTN_ENABLED = bool(os.environ.get("SGLANG_MTP_DRAFT_DUMP_DIR", "").strip())
+    if _POST_ATTN_ENABLED:
+        _POST_ATTN_HC = hidden_states
+
+
+def take_post_attn_hc():
+    global _POST_ATTN_HC
+    value, _POST_ATTN_HC = _POST_ATTN_HC, None
+    return value
+
+
+def maybe_dump_draft(
+    model, input_ids, positions, forward_batch, input_hc, mixed, own_hc
+) -> None:
+    dumper = get_draft_dumper()
+    if dumper is not None:
+        dumper.dump(
+            model, input_ids, positions, forward_batch, input_hc, mixed, own_hc
+        )
+
+
+__all__ = [
+    "project_lm_head",
+    "tap_layer_ids",
+    "MTPDumper",
+    "MTPDraftDumper",
+    "dump_enabled",
+    "get_dumper",
+    "get_draft_dumper",
+    "maybe_stage",
+    "maybe_flush",
+    "maybe_dump_draft",
+    "stash_post_attn_hc",
+    "take_post_attn_hc",
+]
